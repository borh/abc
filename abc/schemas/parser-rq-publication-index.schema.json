{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://w3id.org/abc/schemas/parser-rq-publication-index.schema.json","title":"Parser RQ publication index","version":"1.0.0","type":"object","additionalProperties":false,"required":["schema_id","schema_version","corpus_id","corpus_snapshot_hash","corpus_list_hash","qualification_identity_ref","policy_hash","preservation_schema_hash","validator_semantics_hash","census_hash","expected_work_ids","records"],"properties":{"schema_id":{"const":"https://w3id.org/abc/schemas/parser-rq-publication-index.schema.json"},"schema_version":{"const":"1.0.0"},"corpus_id":{"type":"string"},"corpus_snapshot_hash":{"$ref":"#/$defs/hash"},"corpus_list_hash":{"$ref":"#/$defs/hash"},"qualification_identity_ref":{"$ref":"#/$defs/hash"},"policy_hash":{"$ref":"#/$defs/hash"},"preservation_schema_hash":{"$ref":"#/$defs/hash"},"validator_semantics_hash":{"$ref":"#/$defs/hash"},"census_hash":{"$ref":"#/$defs/hash"},"expected_work_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"records":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["work_id","source_sha256","locator","ref"],"properties":{"work_id":{"type":"string"},"source_sha256":{"$ref":"#/$defs/hash"},"locator":{"type":"string"},"ref":{"$ref":"#/$defs/blob"}}}}},"$defs":{"hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"blob":{"type":"object","additionalProperties":false,"required":["sha256","bytes","media_type"],"properties":{"sha256":{"$ref":"#/$defs/hash"},"bytes":{"type":"integer","minimum":0},"media_type":{"type":"string","minLength":1}}}}}
