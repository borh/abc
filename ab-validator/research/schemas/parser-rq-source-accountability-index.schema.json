{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-source-accountability-index.schema.json",
  "title": "Parser release qualification source-accountability record index",
  "type": "object",
  "required": ["schema_version", "identity_ref", "taxonomy_version", "taxonomy_hash", "coordinate_system", "status", "expected_work_count", "record_count", "records", "errors"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "abc/parser-rq-source-accountability-index/v1"},
    "identity_ref": {"$ref": "#/$defs/hash"},
    "taxonomy_version": {"const": "parser-rq-ignored-regions-v1"},
    "taxonomy_hash": {"$ref": "#/$defs/hash"},
    "coordinate_system": {"const": "decoded_utf8"},
    "status": {"enum": ["ok", "unavailable"]},
    "expected_work_count": {"type": "integer", "minimum": 0},
    "record_count": {"type": "integer", "minimum": 0},
    "records": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "errors": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ok"}}},
      "then": {"properties": {"errors": {"maxItems": 0}}},
      "else": {"properties": {"errors": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "interval": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0}
      }
    },
    "entry": {
      "type": "object",
      "required": ["work_id", "sha256", "bytes", "media_type", "locator"],
      "additionalProperties": false,
      "properties": {
        "work_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 0},
        "media_type": {"const": "application/json"},
        "locator": {"type": "string", "minLength": 1}
      }
    }
  }
}
