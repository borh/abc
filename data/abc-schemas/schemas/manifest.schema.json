{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/manifest.schema.json",
  "title": "ABC Artifact Manifest",
  "type": "object",
  "required": [
    "manifest_schema_id",
    "artifact_id",
    "artifact_kind",
    "validation_status",
    "manifest_identity_object",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_schema_id": { "type": "string", "minLength": 1 },
    "artifact_id": { "$ref": "#/$defs/hash" },
    "artifact_kind": {
      "type": "string",
      "enum": ["source", "parser-ir", "warnings", "plaintext", "tei", "rdf-view", "tokenized", "analysis", "failure"]
    },
    "validation_status": {
      "type": "string",
      "enum": ["not-run", "passed", "warning", "failed"]
    },
    "manifest_identity_object": { "$ref": "#/$defs/identityObject" },
    "content": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/content" }
      ]
    },
    "sidecars": {
      "type": "array",
      "items": { "$ref": "#/$defs/sidecar" },
      "uniqueItems": true,
      "default": []
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "license": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/license" }
      ]
    },
    "signatures": {
      "type": "array",
      "items": { "$ref": "#/$defs/signature" },
      "uniqueItems": true,
      "default": []
    },
    "superseded_by": { "$ref": "#/$defs/nullableHash" },
    "invalidated_at": {
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "replacement_reason": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableHash": {
      "anyOf": [
        { "$ref": "#/$defs/hash" },
        { "type": "null" }
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_hash", "media_type"],
      "properties": {
        "content_hash": { "$ref": "#/$defs/hash" },
        "media_type": { "type": "string" },
        "byte_length": { "type": "integer", "minimum": 0 },
        "path_hint": { "type": "string" }
      }
    },
    "identityObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_schema_hash",
        "corpus_snapshot_hash",
        "work_content_hash",
        "metadata_record_hash",
        "parser_build_hash",
        "parser_config_hash",
        "aat_parser_ir_mapping_hash",
        "parser_ir_schema_hash",
        "tei_profile_hash",
        "tokenizer_build_hash",
        "tokenizer_dictionary_hash",
        "analysis_recipe_hash",
        "output_format_spec_hash"
      ],
      "properties": {
        "manifest_schema_hash": { "$ref": "#/$defs/hash" },
        "corpus_snapshot_hash": { "$ref": "#/$defs/hash" },
        "work_content_hash": { "$ref": "#/$defs/hash" },
        "metadata_record_hash": { "$ref": "#/$defs/nullableHash" },
        "parser_build_hash": { "$ref": "#/$defs/nullableHash" },
        "parser_config_hash": { "$ref": "#/$defs/nullableHash" },
        "aat_parser_ir_mapping_hash": { "$ref": "#/$defs/nullableHash" },
        "parser_ir_schema_hash": { "$ref": "#/$defs/nullableHash" },
        "tei_profile_hash": { "$ref": "#/$defs/nullableHash" },
        "tokenizer_build_hash": { "$ref": "#/$defs/nullableHash" },
        "tokenizer_dictionary_hash": { "$ref": "#/$defs/nullableHash" },
        "analysis_recipe_hash": { "$ref": "#/$defs/nullableHash" },
        "output_format_spec_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "sidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "hash", "media_type"],
      "properties": {
        "role": { "type": "string", "enum": ["warnings", "errors", "validation-result", "rdf-view", "index-entry", "mapping-divergence", "preservation", "source-region-coverage"] },
        "hash": { "$ref": "#/$defs/hash" },
        "media_type": { "type": "string" },
        "path_hint": { "type": ["string", "null"] }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["spdx_id"] },
        { "required": ["label"] }
      ],
      "properties": {
        "spdx_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "source_url": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at", "activity_id", "used", "was_derived_from"],
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "activity_id": { "type": "string", "format": "uri" },
        "agent": { "type": ["string", "null"] },
        "plan_hash": { "$ref": "#/$defs/nullableHash" },
        "used": {
          "$comment": "Sort lexicographically before RDF generation and fixture comparison. This array is outside manifest_identity_object and does not affect ArtifactID.",
          "type": "array",
          "items": { "$ref": "#/$defs/hash" },
          "uniqueItems": true
        },
        "was_derived_from": {
          "$comment": "Sort lexicographically before RDF generation and fixture comparison. This array is outside manifest_identity_object and does not affect ArtifactID.",
          "type": "array",
          "items": { "$ref": "#/$defs/hash" },
          "uniqueItems": true
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signature_type", "path_hint", "signature_hash"],
      "properties": {
        "signature_type": { "type": "string", "enum": ["detached", "sigstore-bundle", "in-toto-attestation"] },
        "path_hint": { "type": "string" },
        "signature_hash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
