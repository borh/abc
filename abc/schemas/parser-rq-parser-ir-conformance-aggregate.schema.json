{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://w3id.org/abc/schemas/parser-rq-parser-ir-conformance-aggregate.schema.json","type":"object","additionalProperties":false,
  "required":["schema_id","schema_version","qualification_identity_ref","policy_hash","status","expected_works","generated_outputs","schema_valid_outputs","schema_invalid_outputs","no_output_works"],
  "properties":{"schema_id":{"const":"https://w3id.org/abc/schemas/parser-rq-parser-ir-conformance-aggregate.schema.json"},"schema_version":{"const":"1.0.0"},"qualification_identity_ref":{"$ref":"#/$defs/hash"},"policy_hash":{"$ref":"#/$defs/hash"},"status":{"enum":["measured","no_parser_ir_output","unavailable"]},"expected_works":{"type":"integer","minimum":1},"generated_outputs":{"type":"integer","minimum":0},"schema_valid_outputs":{"type":"integer","minimum":0},"schema_invalid_outputs":{"type":"integer","minimum":0},"no_output_works":{"type":"integer","minimum":0},"parser_ir_schema_validation":{"type":"number","minimum":0,"maximum":1},"reason":{"$ref":"#/$defs/reason"}},
  "allOf":[{"if":{"properties":{"status":{"const":"measured"}}},"then":{"required":["parser_ir_schema_validation"],"properties":{"generated_outputs":{"minimum":1}},"not":{"required":["reason"]}}},{"if":{"properties":{"status":{"const":"no_parser_ir_output"}}},"then":{"properties":{"generated_outputs":{"const":0},"schema_valid_outputs":{"const":0},"schema_invalid_outputs":{"const":0}},"not":{"anyOf":[{"required":["parser_ir_schema_validation"]},{"required":["reason"]}]}}},{"if":{"properties":{"status":{"const":"unavailable"}}},"then":{"required":["reason"],"not":{"required":["parser_ir_schema_validation"]}}}],
  "$defs":{"hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"reason":{"enum":["blob_unavailable","identity_mismatch","policy_mismatch","schema_mismatch","validator_mismatch","index_incomplete","aggregate_invalid"]}}
}
