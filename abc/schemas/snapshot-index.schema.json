{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/snapshot-index.schema.json",
  "title": "ABC Snapshot Index",
  "version": "0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "schema_hash",
    "snapshot_date",
    "generated_at",
    "snapshot_identity_hash",
    "snapshot_index_identity_object",
    "source_selection_identity_object",
    "parser_runtime_identity_object",
    "failure_policy",
    "layout_policy",
    "failures",
    "artifact_references",
    "summary"
  ],
  "properties": {
    "schema_id": {
      "const": "https://w3id.org/abc/schemas/snapshot-index.schema.json"
    },
    "schema_version": { "const": "0.2.0" },
    "schema_hash": { "$ref": "#/$defs/hash" },
    "snapshot_date": { "$ref": "#/$defs/date" },
    "generated_at": { "type": "string", "minLength": 1 },
    "snapshot_identity_hash": { "$ref": "#/$defs/hash" },
    "snapshot_index_identity_object": {
      "$ref": "#/$defs/snapshotIndexIdentityObject"
    },
    "source_selection_identity_object": {
      "$ref": "#/$defs/sourceSelectionIdentityObject"
    },
    "parser_runtime_identity_object": {
      "$ref": "#/$defs/parserRuntimeIdentityObject"
    },
    "failure_policy": { "$ref": "#/$defs/failurePolicy" },
    "layout_policy": { "$ref": "#/$defs/layoutPolicy" },
    "failures": {
      "type": "array",
      "items": { "$ref": "#/$defs/failureRecord" }
    },
    "artifact_references": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifactReference" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableHash": {
      "anyOf": [
        { "$ref": "#/$defs/hash" },
        { "type": "null" }
      ]
    },
    "hashArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/hash" },
      "uniqueItems": true
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "gitCommit": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        { "type": "null" }
      ]
    },
    "snapshotIndexIdentityObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_index_schema_hash",
        "source_selection_hash",
        "candidate_ref",
        "qualification_identity_ref",
        "parser_config_hash",
        "artifact_set_hash",
        "failure_set_hash",
        "failure_policy_hash",
        "layout_policy_hash",
        "schema_hashes"
      ],
      "properties": {
        "snapshot_index_schema_hash": { "$ref": "#/$defs/hash" },
        "source_selection_hash": { "$ref": "#/$defs/hash" },
        "candidate_ref": { "$ref": "#/$defs/nullableHash" },
        "qualification_identity_ref": { "$ref": "#/$defs/nullableHash" },
        "parser_config_hash": { "$ref": "#/$defs/hash" },
        "artifact_set_hash": { "$ref": "#/$defs/hash" },
        "failure_set_hash": { "$ref": "#/$defs/hash" },
        "failure_policy_hash": { "$ref": "#/$defs/hash" },
        "layout_policy_hash": { "$ref": "#/$defs/hash" },
        "schema_hashes": { "$ref": "#/$defs/hashArray" }
      }
    },
    "sourceSelectionIdentityObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trust_mode",
        "aozora_git_commit",
        "catalog_csv_hash",
        "snapshot_date",
        "sources"
      ],
      "properties": {
        "trust_mode": { "enum": ["official-git", "fixture"] },
        "aozora_git_commit": { "$ref": "#/$defs/gitCommit" },
        "catalog_csv_hash": { "$ref": "#/$defs/hash" },
        "snapshot_date": { "$ref": "#/$defs/date" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceRow" }
        }
      }
    },
    "sourceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "person_id",
        "slug",
        "text_zip_relpath",
        "archive_hash",
        "bundle_hash",
        "primary_text_member",
        "primary_text_hash",
        "metadata_record_hash"
      ],
      "properties": {
        "work_id": { "type": "string", "minLength": 1 },
        "person_id": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "text_zip_relpath": { "$ref": "#/$defs/relativePath" },
        "archive_hash": { "$ref": "#/$defs/hash" },
        "bundle_hash": { "$ref": "#/$defs/hash" },
        "primary_text_member": { "type": "string", "minLength": 1 },
        "primary_text_hash": { "$ref": "#/$defs/hash" },
        "metadata_record_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "parserRuntimeIdentityObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "adapter_argv_template",
        "converter_argv_template",
        "parser_build_hash",
        "converter_build_hash",
        "aat_parser_ir_mapping_hash",
        "parser_ir_schema_hash"
      ],
      "properties": {
        "adapter_id": { "type": "string", "minLength": 1 },
        "adapter_argv_template": {
          "type": "array",
          "items": { "type": "string" }
        },
        "converter_argv_template": {
          "type": "array",
          "items": { "type": "string" }
        },
        "parser_build_hash": { "$ref": "#/$defs/hash" },
        "converter_build_hash": { "$ref": "#/$defs/hash" },
        "aat_parser_ir_mapping_hash": { "$ref": "#/$defs/hash" },
        "parser_ir_schema_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "failureRecord": {
      "type": "object",
      "required": ["stage", "work_slug", "code"],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "work_slug": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "failurePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_nonzero_failures",
        "max_failure_rate",
        "per_diagnostic_tolerances"
      ],
      "properties": {
        "allow_nonzero_failures": { "type": "boolean" },
        "max_failure_rate": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        },
        "per_diagnostic_tolerances": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "layoutPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loose_artifact_kinds",
        "batched_artifact_kinds",
        "batch_target_work_count",
        "archive_format"
      ],
      "properties": {
        "loose_artifact_kinds": {
          "type": "array",
          "items": { "enum": ["source", "parser-ir", "tei", "plaintext", "annotation"] },
          "uniqueItems": true
        },
        "batched_artifact_kinds": {
          "type": "array",
          "items": { "enum": ["analysis", "tokenized"] },
          "uniqueItems": true
        },
        "batch_target_work_count": {
          "type": "integer",
          "minimum": 1
        },
        "archive_format": {
          "const": "tar.zst"
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_kind",
        "work_slug",
        "sidecar_role",
        "validation_status",
        "manifest_content_hash",
        "content_hash",
        "locator"
      ],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/hash" },
        "artifact_kind": {
          "enum": [
            "source",
            "parser-ir",
            "plaintext",
            "tei"
          ]
        },
        "work_slug": { "type": "string", "minLength": 1 },
        "sidecar_role": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "validation_status": {
          "enum": ["passed", "warning", "failed"]
        },
        "manifest_content_hash": { "$ref": "#/$defs/hash" },
        "content_hash": {
          "anyOf": [
            { "$ref": "#/$defs/hash" },
            { "type": "null" }
          ]
        },
        "locator": { "$ref": "#/$defs/artifactLocator" }
      }
    },
    "artifactLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["loose", "archive-member"] },
        "path": { "type": "string", "minLength": 1 },
        "archive_path": { "type": "string", "minLength": 1 },
        "member_path": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "loose" } },
            "required": ["kind"]
          },
          "then": { "required": ["path"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "archive-member" } },
            "required": ["kind"]
          },
          "then": { "required": ["archive_path", "member_path"] }
        }
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_artifacts",
        "success_count",
        "failure_count",
        "failure_rate"
      ],
      "properties": {
        "total_artifacts": { "type": "integer", "minimum": 0 },
        "success_count": { "type": "integer", "minimum": 0 },
        "failure_count": { "type": "integer", "minimum": 0 },
        "failure_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
