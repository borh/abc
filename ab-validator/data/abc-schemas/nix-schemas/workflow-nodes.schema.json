{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/workflow-nodes.schema.json",
  "title": "Soranoha workflow node summary record",
  "version": "0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "key", "node_type", "status", "realized"],
  "properties": {
    "schema_version": {"const": "soranoha-workflow-nodes-v1"},
    "run_id": {"type": "string"},
    "workflow_id": {"type": "string"},
    "step_id": {"type": "string"},
    "key": {"type": "string"},
    "node_type": {"enum": ["value", "leaf", "branch"]},
    "status": {"enum": ["passed", "failed", "partial", "skipped"]},
    "realized": {"type": "boolean"},
    "inputs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "conditional_inputs_skipped": {
      "type": "array",
      "items": {"type": "string"}
    },
    "duration_ms": {"type": "integer", "minimum": 0},
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["hit", "miss", "stale", "invalid"]},
        "key": {"type": "string"}
      }
    }
  }
}
