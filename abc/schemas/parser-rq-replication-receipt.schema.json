{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-replication-receipt.schema.json",
  "title": "Parser RQ replication receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "receipt_ref", "candidate_ref", "capture_generation_ref", "primary_failure_domain", "replica_failure_domain", "status"],
  "properties": {
    "schema_id": {"const": "https://w3id.org/abc/schemas/parser-rq-replication-receipt.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "receipt_ref": {"$ref": "#/$defs/hash"},
    "candidate_ref": {"$ref": "#/$defs/hash"},
    "capture_generation_ref": {"$ref": "#/$defs/hash"},
    "primary_failure_domain": {"type": "string", "minLength": 1},
    "replica_failure_domain": {"type": "string", "minLength": 1},
    "status": {"enum": ["replicated", "unavailable"]},
    "blobs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["blob", "primary_rehash", "replica_rehash"], "properties": {"blob": {"$ref": "#/$defs/blob"}, "primary_rehash": {"$ref": "#/$defs/hash"}, "replica_rehash": {"$ref": "#/$defs/hash"}}}},
    "reason": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "replicated"}}}, "then": {"required": ["blobs"], "not": {"required": ["reason"]}}},
    {"if": {"properties": {"status": {"const": "unavailable"}}}, "then": {"required": ["reason"], "not": {"required": ["blobs"]}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "blob": {"type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "media_type", "locator"], "properties": {"sha256": {"$ref": "#/$defs/hash"}, "bytes": {"type": "integer", "minimum": 0}, "media_type": {"type": "string", "minLength": 1}, "locator": {"$ref": "#/$defs/locator"}}},
    "locator": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
  }
}
