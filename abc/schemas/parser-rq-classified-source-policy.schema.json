{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-classified-source-policy.schema.json",
  "type": "object",
  "required": ["schema_version", "policy_id", "policy_hash", "parser", "coordinate_system", "roles", "dispositions", "metadata_attributing_roles", "accent_mappings", "rules"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "abc/parser-rq-classified-source-policy/v1"},
    "policy_id": {"const": "parser-rq-ab-aozora-classified-source-v1"},
    "policy_hash": {"$ref": "#/$defs/hash"},
    "parser": {"const": "ab-aozora"},
    "coordinate_system": {"const": "decoded_utf8"},
    "roles": {"const": ["visible_text", "structural_newline", "ruby", "typography", "gaiji", "layout", "break", "heading", "illustration", "kunten", "source_annotation", "container_syntax", "terminal_provenance", "publication_metadata", "editorial_legend", "bibliographic", "distribution_notice", "editorial_remark", "file_provenance", "licence_terms", "unrecognized_source_form"]},
    "dispositions": {"const": ["emitted_semantic_value", "preserved_sidecar_value", "structural_control", "lossless_normalization", "preserved_opaque"]},
    "metadata_attributing_roles": {"description": "The closed set of source roles whose facts ATTRIBUTE a metadata byte: the numerator of the metadata attribution measure. Governed data rather than a constant in the instrument, so widening what counts as understood packaging rotates this policy_hash and, through instrument_policy_hashes, the qualification identity. Two rules are structural and deliberately NOT expressible here. A preserved_opaque entry never attributes, because that disposition IS the statement that no claim is made about the bytes. And a role outside this set may still ACCOUNT for a byte without attributing it, which is how a colophon line ending carries a crlf_normalization fact without making the colophon understood.", "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/role"}},
    "accent_mappings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/accent_mapping"}},
    "rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "role": {"enum": ["visible_text", "structural_newline", "ruby", "typography", "gaiji", "layout", "break", "heading", "illustration", "kunten", "source_annotation", "container_syntax", "terminal_provenance", "publication_metadata", "editorial_legend", "bibliographic", "distribution_notice", "editorial_remark", "file_provenance", "licence_terms", "unrecognized_source_form"]},
    "disposition": {"enum": ["emitted_semantic_value", "preserved_sidecar_value", "structural_control", "lossless_normalization", "preserved_opaque"]},
    "accent_mapping": {"type": "object", "required": ["source", "normalized"], "additionalProperties": false, "properties": {"source": {"type": "string", "pattern": "^[A-Za-z]{1,2}['`^:~&,/_]$"}, "normalized": {"type": "string", "minLength": 1, "maxLength": 1}}},
    "rule": {
      "type": "object",
      "required": ["construct_id", "source_role", "disposition", "evidence_class"],
      "additionalProperties": false,
      "properties": {
        "construct_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "source_role": {"$ref": "#/$defs/role"},
        "disposition": {"$ref": "#/$defs/disposition"},
        "evidence_class": {"enum": ["accepted_text", "recovered_verbatim", "typed_node", "structural_token", "typed_container", "unknown_directive", "sanitizer_transform"]},
        "target_relation": {"enum": ["emits", "preserves"]},
        "witness_kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      },
      "allOf": [
        {"if": {"properties": {"disposition": {"enum": ["emitted_semantic_value", "preserved_sidecar_value", "lossless_normalization"]}}}, "then": {"required": ["target_relation"]}, "else": {"not": {"required": ["target_relation"]}}},
        {"if": {"properties": {"disposition": {"enum": ["structural_control", "preserved_opaque"]}}}, "then": {"required": ["witness_kind"]}, "else": {"not": {"required": ["witness_kind"]}}},
        {"if": {"properties": {"disposition": {"const": "preserved_opaque"}}}, "then": {"properties": {"source_role": {"const": "unrecognized_source_form"}, "witness_kind": {"enum": ["recovered_verbatim", "unknown_directive"]}}}}
      ]
    }
  }
}
