    "text_variant": {"type":"object","required":["kind","content","base_text","base_content","source","span"],"additionalProperties":false,"properties":{"kind":{"const":"text-variant"},"current_interpretation_facts":{"description":"Source-owned claims for the supplied current quotation, emitted only after its target and structural constraints match.","type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/interpretationFact"}},"content":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/inline"}},"base_text":{"type":"string","description":"Explicit witness text; empty means source-stated absence."},"base_content":{"type":"array","items":{"$ref":"#/$defs/inline"}},"source":{"type":"string","minLength":1},"span":{"$ref":"#/$defs/span"}}},
