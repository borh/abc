{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-comparison-result-v2.schema.json",
  "title": "Soranoha parser comparison result IR version 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "study_id", "rows"],
  "properties": {
    "schema_id": {"const": "https://w3id.org/abc/schemas/parser-comparison-result-v2"},
    "schema_version": {"const": 2},
    "study_id": {"type": "string", "minLength": 1},
    "rows": {
      "type": "array",
      "minItems": 108,
      "maxItems": 108,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "axis", "measurement_mode", "parser_revision", "adapter_revision", "corpus_hash", "summary_disposition", "metrics", "caveats", "provenance"],
      "allOf": [
        {
          "if": {"properties": {"measurement_mode": {"const": "native"}}, "required": ["measurement_mode"]},
          "then": {"properties": {"adapter_revision": {"type": "null"}, "provenance": {"allOf": [{"contains": {"const": "native_parser"}}, {"not": {"contains": {"enum": ["adapter", "source_lexer_fallback", "mapper"]}}}]}}}
        },
        {
          "if": {"properties": {"measurement_mode": {"const": "adapter_normalized"}}, "required": ["measurement_mode"]},
          "then": {"properties": {"adapter_revision": {"type": "string", "minLength": 1}, "provenance": {"contains": {"enum": ["adapter", "source_lexer_fallback", "mapper"]}}}}
        },
        {
          "if": {"properties": {"candidate": {"enum": ["aozora-parser.js", "ab-aozora"]}}, "required": ["candidate"]},
          "then": {"properties": {"measurement_mode": {"const": "native"}}}
        }
      ],
      "properties": {
        "candidate": {"enum": ["aozora", "aozora2", "aozora-rs", "aozora2html", "aozora-epub3", "aozora-parser.js", "ab-aozora"]},
        "axis": {"enum": ["construct_coverage", "fidelity", "robustness", "diagnostics", "spans", "performance", "maintenance", "packaging", "license"]},
        "measurement_mode": {"enum": ["native", "adapter_normalized"]},
        "parser_revision": {"type": "string", "minLength": 1},
        "adapter_revision": {"type": ["string", "null"]},
        "corpus_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "summary_disposition": {"enum": ["measured", "non_comparable", "unavailable", "failed"]},
        "metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/metric"}},
        "caveats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "provenance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["native_parser", "adapter", "source_lexer_fallback", "mapper", "source_authority"]}}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "disposition"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["measured", "non_comparable", "unavailable", "failed"]},
        "value": {"$ref": "#/$defs/metric_value"},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "measured"}}, "required": ["disposition"]},
          "then": {"required": ["value"], "not": {"required": ["reason"]}},
          "else": {"required": ["reason"], "not": {"required": ["value"]}}
        }
      ]
    },
    "metric_value": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "count"}, "value": {"type": "integer", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "numerator", "denominator"], "properties": {"kind": {"const": "ratio"}, "numerator": {"type": "integer", "minimum": 0}, "denominator": {"type": "integer", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "bytes"}, "value": {"type": "integer", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "seconds"}, "value": {"type": "number", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "boolean"}, "value": {"type": "boolean"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "text"}, "value": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "lower", "upper", "unit"], "properties": {"kind": {"const": "interval"}, "lower": {"type": "number"}, "upper": {"type": ["number", "null"]}, "unit": {"type": "string", "minLength": 1}}}
      ]
    }
  }
}
