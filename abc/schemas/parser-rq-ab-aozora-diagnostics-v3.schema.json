{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-ab-aozora-diagnostics-v3.schema.json",
  "type": "object",
  "required": ["schema_version", "parser", "coordinate_system", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "abc/parser-rq-ab-aozora-diagnostics/v3"},
    "parser": {"const": "ab-aozora"},
    "coordinate_system": {"const": "decoded_utf8"},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "$defs": {
    "code": {"enum": ["source-contains-pua", "unclosed-bracket", "unmatched-close", "accent-decomposition-applied", "unresolved-gaiji", "mismatched-container-close", "empty-ruby-reading", "nested-ruby", "unrecognised-container-directive", "tcy-target-not-found", "bouten-target-ambiguous", "forward-referent-not-stylable", "break-in-single-line-container", "bracketed-kaeriten-no-pair", "kaeriten-outside-kanbun", "mismatched-bouten-container", "non-canonical-directive", "residual-annotation-marker", "unregistered-sentinel", "registry-out-of-order", "registry-position-mismatch"]},
    "kind": {"enum": ["source_contains_pua", "unclosed_bracket", "unmatched_close", "accent_decomposition_applied", "unresolved_gaiji", "mismatched_container_close", "empty_ruby_reading", "nested_ruby", "unrecognised_container_directive", "tcy_target_not_found", "bouten_target_ambiguous", "forward_referent_not_stylable", "break_in_single_line_container", "bracketed_kaeriten_no_pair", "kaeriten_outside_kanbun", "mismatched_bouten_container", "non_canonical_directive", "residual_annotation_marker", "unregistered_sentinel", "registry_out_of_order", "registry_position_mismatch"]},
    "interval": {"type": "object", "required": ["start", "end"], "additionalProperties": false, "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}},
    "diagnostic": {
      "type": "object",
      "required": ["kind", "code", "severity", "source", "span"],
      "additionalProperties": false,
      "properties": {"kind": {"$ref": "#/$defs/kind"}, "code": {"$ref": "#/$defs/code"}, "severity": {"enum": ["note", "warning", "error"]}, "source": {"enum": ["source", "internal"]}, "span": {"$ref": "#/$defs/interval"}, "codepoint": {"type": "string", "minLength": 1, "maxLength": 1}},
      "if": {"properties": {"code": {"const": "source-contains-pua"}}, "required": ["code"]},
      "then": {"required": ["codepoint"]},
      "else": {"not": {"required": ["codepoint"]}}
    }
  }
}
