{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-core-attempt-policy.schema.json",
  "title": "Parser RQ core attempt policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "instrument_id", "policy_hash", "expected_work_ids", "expected_sources", "expected_work_set_hash", "repetitions", "reduction", "timeout_seconds", "jobs", "serial", "lock_policy", "gnu_time", "argv_template", "allowed_dispositions", "schema_hashes", "capture_semantics_hash", "analyzer_semantics_hash"],
  "properties": {
    "schema_id": {"const": "https://w3id.org/abc/schemas/parser-rq-core-attempt-policy.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "instrument_id": {"const": "parser-rq-core-attempt-v1"},
    "policy_hash": {"$ref": "#/$defs/hash"},
    "expected_work_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "expected_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["work_id", "source_sha256"], "properties": {"work_id": {"type": "string", "minLength": 1}, "source_sha256": {"$ref": "#/$defs/hash"}}}},
    "expected_work_set_hash": {"$ref": "#/$defs/hash"},
    "repetitions": {"const": 3},
    "reduction": {"const": "maximum"},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "jobs": {"const": 1},
    "serial": {"const": true},
    "lock_policy": {"type": "object", "additionalProperties": false, "required": ["exclusive", "retained"], "properties": {"exclusive": {"const": true}, "retained": {"const": true}}},
    "gnu_time": {"type": "object", "additionalProperties": false, "required": ["executable", "format", "locale"], "properties": {"executable": {"$ref": "#/$defs/blob"}, "format": {"const": "%e"}, "locale": {"const": "C"}}},
    "argv_template": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_dispositions": {"const": ["parsed", "fatal_error", "adapter_timeout", "protocol_error"]},
    "schema_hashes": {"type": "object", "additionalProperties": false, "required": ["policy", "work", "index", "aggregate"], "properties": {"policy": {"$ref": "#/$defs/hash"}, "work": {"$ref": "#/$defs/hash"}, "index": {"$ref": "#/$defs/hash"}, "aggregate": {"$ref": "#/$defs/hash"}}},
    "capture_semantics_hash": {"$ref": "#/$defs/hash"},
    "analyzer_semantics_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "blob": {"type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "media_type", "locator"], "properties": {"sha256": {"$ref": "#/$defs/hash"}, "bytes": {"type": "integer", "minimum": 0}, "media_type": {"type": "string", "minLength": 1}, "locator": {"$ref": "#/$defs/locator"}}},
    "locator": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
  }
}
