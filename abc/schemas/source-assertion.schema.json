{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/source-assertion.schema.json",
  "title": "ABC Source Assertion",
  "version": "0.1.0",
  "type": "object",
  "required": ["source", "field", "lexical_value", "snapshot_hash"],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1
    },
    "field": {
      "type": "string",
      "minLength": 1
    },
    "lexical_value": {
      "type": ["string", "null"]
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
