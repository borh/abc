{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/tei-eaj-comparison.schema.json",
  "title": "ABC TEI-EAJ Aozora Comparison Export",
  "version": "0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tei_eaj_source",
    "abc_inputs",
    "summary",
    "candidate_work_ids",
    "missing_abc_counterpart_work_ids",
    "no_work_id_files",
    "files"
  ],
  "properties": {
    "schema_version": { "const": "tei-eaj-aozora-workset-export-v1" },
    "tei_eaj_source": { "$ref": "#/$defs/teiEajSource" },
    "abc_inputs": { "$ref": "#/$defs/abcInputs" },
    "summary": { "$ref": "#/$defs/summary" },
    "candidate_work_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/workId" },
      "uniqueItems": true
    },
    "missing_abc_counterpart_work_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/workId" },
      "uniqueItems": true
    },
    "no_work_id_files": {
      "type": "array",
      "items": { "$ref": "#/$defs/path" },
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/fileComparison" }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "nullablePath": {
      "anyOf": [
        { "$ref": "#/$defs/path" },
        { "type": "null" }
      ]
    },
    "workId": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "nullableWorkId": {
      "anyOf": [
        { "$ref": "#/$defs/workId" },
        { "type": "null" }
      ]
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "nullableNonNegativeInteger": {
      "anyOf": [
        { "$ref": "#/$defs/nonNegativeInteger" },
        { "type": "null" }
      ]
    },
    "integerOrNull": {
      "anyOf": [
        { "type": "integer" },
        { "type": "null" }
      ]
    },
    "stringOrNull": {
      "anyOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "teiEajSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "revision"],
      "properties": {
        "root": { "$ref": "#/$defs/path" },
        "revision": { "$ref": "#/$defs/stringOrNull" }
      }
    },
    "abcInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tei_specs", "tei_dirs", "counterparts"],
      "properties": {
        "tei_specs": {
          "type": "array",
          "items": { "$ref": "#/$defs/path" }
        },
        "tei_dirs": {
          "type": "array",
          "items": { "$ref": "#/$defs/path" }
        },
        "counterparts": {
          "type": "array",
          "items": { "$ref": "#/$defs/counterpart" }
        }
      }
    },
    "counterpart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_id", "path"],
      "properties": {
        "work_id": { "$ref": "#/$defs/workId" },
        "path": { "$ref": "#/$defs/path" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tei_eaj_file_count",
        "tei_eaj_work_id_count",
        "abc_counterpart_count",
        "compared_file_count",
        "missing_counterpart_count",
        "no_work_id_count",
        "uncompared_file_count",
        "base_text_equal_count",
        "base_text_mismatch_count",
        "base_text_relation_counts"
      ],
      "properties": {
        "tei_eaj_file_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "tei_eaj_work_id_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "abc_counterpart_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "compared_file_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "missing_counterpart_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "no_work_id_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "uncompared_file_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "base_text_equal_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "base_text_mismatch_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "base_text_relation_counts": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/baseTextRelationName" },
          "additionalProperties": { "$ref": "#/$defs/nonNegativeInteger" }
        }
      }
    },
    "workIdMethod": {
      "anyOf": [
        {
          "enum": [
            "filename_work_id",
            "filename_header_work_id",
            "filename_work_id_variant",
            "filename_work_id_file_id",
            "filename_numeric_work_id",
            "title_unique_index_correction",
            "no_work_id"
          ]
        },
        { "type": "null" }
      ]
    },
    "comparisonStatus": {
      "enum": [
        "compared",
        "missing_abc_counterpart",
        "no_tei_eaj_work_id"
      ]
    },
    "baseTextRelation": {
      "anyOf": [
        {
          "$ref": "#/$defs/baseTextRelationName"
        },
        { "type": "null" }
      ]
    },
    "baseTextRelationName": {
      "enum": [
        "equal",
        "tei_eaj_subset_of_abc",
        "abc_subset_of_tei_eaj",
        "mismatch",
        "missing_abc_counterpart"
      ]
    },
    "firstDifference": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "abc", "tei_eaj"],
          "properties": {
            "index": { "$ref": "#/$defs/nonNegativeInteger" },
            "abc": { "type": "string" },
            "tei_eaj": { "type": "string" }
          }
        },
        { "type": "null" }
      ]
    },
    "fileComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "work_id_method",
        "tei_eaj_file",
        "state",
        "level",
        "title",
        "abc_tei",
        "comparison_status",
        "base_text_equal",
        "base_text_relation",
        "base_text_length_delta",
        "abc_body_base_text_length",
        "tei_eaj_body_base_text_length",
        "abc_p_count",
        "tei_eaj_p_count",
        "abc_note_count",
        "tei_eaj_note_count",
        "first_difference"
      ],
      "properties": {
        "work_id": { "$ref": "#/$defs/nullableWorkId" },
        "work_id_method": { "$ref": "#/$defs/workIdMethod" },
        "tei_eaj_file": { "$ref": "#/$defs/path" },
        "state": { "$ref": "#/$defs/stringOrNull" },
        "level": { "$ref": "#/$defs/stringOrNull" },
        "title": { "$ref": "#/$defs/stringOrNull" },
        "abc_tei": { "$ref": "#/$defs/nullablePath" },
        "comparison_status": { "$ref": "#/$defs/comparisonStatus" },
        "base_text_equal": {
          "anyOf": [
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "base_text_relation": { "$ref": "#/$defs/baseTextRelation" },
        "base_text_length_delta": { "$ref": "#/$defs/integerOrNull" },
        "abc_body_base_text_length": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "tei_eaj_body_base_text_length": { "$ref": "#/$defs/nonNegativeInteger" },
        "abc_p_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "tei_eaj_p_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "abc_note_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "tei_eaj_note_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "first_difference": { "$ref": "#/$defs/firstDifference" },
        "alignment_probe": {
          "anyOf": [
            { "$ref": "alignment-probe-v1.schema.json" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
