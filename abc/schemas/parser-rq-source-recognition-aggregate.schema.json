{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-source-recognition-aggregate.schema.json",
  "title": "Parser release qualification source-recognition aggregate",
  "type": "object",
  "required": ["schema_version", "qualification_identity_ref", "generation_ref", "policy_hash", "membership_ref", "coordinate_system", "status", "work_completeness"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "abc/parser-rq-source-recognition-aggregate/v1"},
    "qualification_identity_ref": {"$ref": "#/$defs/hash"},
    "generation_ref": {"$ref": "#/$defs/hash"},
    "policy_hash": {"$ref": "#/$defs/hash"},
    "membership_ref": {"$ref": "#/$defs/hash"},
    "coordinate_system": {"const": "decoded_utf8"},
    "status": {"enum": ["ok", "unavailable"]},
    "work_completeness": {"$ref": "#/$defs/completeness"},
    "eligible_bytes": {"type": "integer", "minimum": 0},
    "recognized_bytes": {"type": "integer", "minimum": 0},
    "accounted_bytes": {"type": "integer", "minimum": 0},
    "semantic_gap_bytes": {"type": "integer", "minimum": 0},
    "unaccounted_bytes": {"type": "integer", "minimum": 0},
    "semantic_gaps": {"type": "array", "items": {"$ref": "#/$defs/work_interval"}},
    "unaccounted": {"type": "array", "items": {"$ref": "#/$defs/work_interval"}},
    "errors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "oneOf": [
    {"properties": {"status": {"const": "ok"}}, "required": ["eligible_bytes", "recognized_bytes", "accounted_bytes", "semantic_gap_bytes", "unaccounted_bytes", "semantic_gaps", "unaccounted"], "not": {"required": ["errors"]}},
    {"properties": {"status": {"const": "unavailable"}}, "required": ["errors"], "not": {"anyOf": [
      {"required": ["eligible_bytes"]}, {"required": ["recognized_bytes"]},
      {"required": ["accounted_bytes"]}, {"required": ["semantic_gap_bytes"]},
      {"required": ["unaccounted_bytes"]}, {"required": ["semantic_gaps"]},
      {"required": ["unaccounted"]}
    ]}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "work_interval": {"type": "object", "required": ["work_id", "start", "end"], "additionalProperties": false, "properties": {"work_id": {"type": "string", "minLength": 1}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}},
    "completeness": {"type": "object", "required": ["expected", "observed", "complete"], "additionalProperties": false, "properties": {"expected": {"type": "integer", "minimum": 0}, "observed": {"type": "integer", "minimum": 0}, "complete": {"type": "boolean"}}}
  }
}
