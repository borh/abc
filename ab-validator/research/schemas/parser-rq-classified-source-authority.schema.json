{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/soranoha/schemas/parser-rq-classified-source-authority.schema.json",
  "type": "object",
  "required": ["schema_version", "generation_ref_contract", "policy", "ledger_schema", "generation_schema"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "abc/parser-rq-classified-source-authority/v1"},
    "generation_ref_contract": {
      "type": "object",
      "required": ["algorithm_id", "canonicalization", "hash", "projection", "excluded_fields", "value_domain", "object_key_domain"],
      "additionalProperties": false,
      "properties": {
        "algorithm_id": {"const": "sha256-rfc8785-string-domain-v1"},
        "canonicalization": {"const": "RFC 8785 JCS"},
        "hash": {"const": "SHA-256"},
        "projection": {"const": "closed-manifest-minus-generation_ref"},
        "excluded_fields": {"const": ["generation_ref"]},
        "value_domain": {"const": "objects-arrays-strings-only"},
        "object_key_domain": {"const": "schema-fixed-ascii"}
      }
    },
    "policy": {"$ref": "#/$defs/authority"},
    "ledger_schema": {"$ref": "#/$defs/authority"},
    "generation_schema": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authority": {"type": "object", "required": ["raw_bytes_hash", "identity_hash"], "additionalProperties": false, "properties": {"raw_bytes_hash": {"$ref": "#/$defs/hash"}, "identity_hash": {"$ref": "#/$defs/hash"}}}
  }
}
