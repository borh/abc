{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-classified-source-policy.schema.json",
  "type": "object",
  "required": ["schema_version", "policy_id", "policy_hash", "parser", "coordinate_system", "roles", "dispositions", "rules"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "abc/parser-rq-classified-source-policy/v1"},
    "policy_id": {"const": "parser-rq-ab-aozora-classified-source-v1"},
    "policy_hash": {"$ref": "#/$defs/hash"},
    "parser": {"const": "ab-aozora"},
    "coordinate_system": {"const": "decoded_utf8"},
    "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/role"}},
    "dispositions": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/disposition"}},
    "rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "role": {"enum": ["visible_text", "structural_newline", "ruby", "typography", "gaiji", "layout", "break", "heading", "illustration", "kunten", "source_annotation", "container_syntax", "terminal_provenance", "publication_metadata", "unrecognized_source_form"]},
    "disposition": {"enum": ["emitted_semantic_value", "preserved_sidecar_value", "structural_control", "lossless_normalization", "preserved_opaque"]},
    "rule": {
      "type": "object",
      "required": ["case", "classified_kind", "plain_provenance", "source_role", "disposition", "parser_evidence_code"],
      "additionalProperties": false,
      "properties": {
        "case": {"type": "string", "minLength": 1},
        "classified_kind": {"enum": ["Plain", "Newline", "Aozora", "BlockOpen", "BlockClose"]},
        "plain_provenance": {"enum": ["Text", "RecoveredVerbatim", "not_plain"]},
        "source_role": {"$ref": "#/$defs/role"},
        "disposition": {"$ref": "#/$defs/disposition"},
        "parser_evidence_code": {"type": "string", "minLength": 1}
      },
      "allOf": [{"if": {"properties": {"disposition": {"const": "preserved_opaque"}}}, "then": {"properties": {"source_role": {"const": "unrecognized_source_form"}}}}]
    }
  }
}
