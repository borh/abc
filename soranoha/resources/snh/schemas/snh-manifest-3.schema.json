{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:snh:schema:release-manifest:3",
  "title": "snh-manifest/3",
  "description": "Release manifest structure (wire version 3: adds the upstream range a release covers and the per-work annotation layer slot). This schema governs structure only; ordering, uniqueness, and cross-object invariants are semantic rules checked by the verifier. Closed schema: no members beyond those listed. No dates of any kind appear in manifest bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "corpus",
    "toolchain",
    "selection_params",
    "admission",
    "catalog",
    "rights",
    "works",
    "withdrawn",
    "validation_summary",
    "governance_event",
    "prev_manifest"
  ],
  "properties": {
    "schema": {
      "const": "snh-manifest/3"
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_origin",
        "upstream_rev",
        "covers_from"
      ],
      "properties": {
        "upstream_origin": {
          "type": "string",
          "minLength": 1
        },
        "upstream_rev": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "covers_from": {
          "description": "The predecessor release's upstream_rev, or null at genesis. The release covers (covers_from, upstream_rev] in upstream history.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "toolchain": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9a-z][0-9a-z-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nix_closure_hash",
          "stage_code_version"
        ],
        "properties": {
          "nix_closure_hash": {
            "type": "string",
            "minLength": 1
          },
          "stage_code_version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "selection_params": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "integer"
        ],
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_hash",
        "inclusion_rule_id",
        "inclusion_rule_hash",
        "assessment_snapshot",
        "admission_report"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_hash": {
          "$ref": "#/$defs/hex64"
        },
        "inclusion_rule_id": {
          "type": "string",
          "minLength": 1
        },
        "inclusion_rule_hash": {
          "$ref": "#/$defs/hex64"
        },
        "assessment_snapshot": {
          "type": "string",
          "pattern": "^snh:1:assessment-snapshot:[0-9a-f]{64}$"
        },
        "admission_report": {
          "type": "string",
          "pattern": "^snh:1:admission-report:[0-9a-f]{64}$"
        }
      }
    },
    "catalog": {
      "type": "string",
      "pattern": "^snh:1:catalog:[0-9a-f]{64}$"
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "statement_url"
      ],
      "properties": {
        "encoding": {
          "type": "string",
          "minLength": 1
        },
        "statement_url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "works": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "source_content_hash",
          "rights",
          "artifacts",
          "layers"
        ],
        "properties": {
          "slug": {
            "$ref": "#/$defs/slug"
          },
          "source_content_hash": {
            "$ref": "#/$defs/hex64"
          },
          "rights": {
            "$ref": "#/$defs/works-standing"
          },
          "artifacts": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              {
                "$ref": "#/$defs/artifact",
                "properties": {
                  "type": {
                    "const": "markdown"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^snh:1:markdown:[0-9a-f]{64}$"
                  }
                }
              },
              {
                "$ref": "#/$defs/artifact",
                "properties": {
                  "type": {
                    "const": "plaintext"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^snh:1:plaintext:[0-9a-f]{64}$"
                  }
                }
              },
              {
                "$ref": "#/$defs/artifact",
                "properties": {
                  "type": {
                    "const": "tei"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^snh:1:tei:[0-9a-f]{64}$"
                  }
                }
              },
              {
                "$ref": "#/$defs/artifact",
                "properties": {
                  "type": {
                    "const": "tei-validation"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^snh:1:tei-validation:[0-9a-f]{64}$"
                  }
                }
              }
            ],
            "items": false
          },
          "layers": {
            "description": "Annotation layers published for this work, sorted by id, ids unique. Empty when the work has none.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "bytes"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^snh:1:annotation-layer:[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          }
        }
      }
    },
    "withdrawn": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "event"
        ],
        "properties": {
          "slug": {
            "$ref": "#/$defs/slug"
          },
          "event": {
            "$ref": "#/$defs/governance-event-id"
          }
        }
      }
    },
    "validation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invalid_count",
        "invalid_slugs"
      ],
      "properties": {
        "invalid_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "invalid_slugs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    },
    "governance_event": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/governance-event-id"
        }
      ]
    },
    "prev_manifest": {
      "$ref": "#/$defs/hex64"
    }
  },
  "$defs": {
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "works-standing": {
      "type": "string",
      "enum": [
        "public-domain",
        "CC-BY-2.1-JP",
        "CC-BY-3.0",
        "CC-BY-4.0"
      ]
    },
    "slug": {
      "type": "string",
      "pattern": "^[0-9a-z_-]+$"
    },
    "governance-event-id": {
      "type": "string",
      "pattern": "^snh:1:governance-event:[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "bytes"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
