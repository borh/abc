{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-source-recognition-aggregate-v1.schema.json",
  "title": "Parser release qualification source-recognition aggregate (v1, frozen)",
  "description": "Frozen. Validates recognition aggregates on the retired wire version abc/parser-rq-source-recognition-aggregate/v1, whose eligible_bytes folded whole-file denominators. Nothing emits this shape; it exists so already-published evidence stays checkable. See docs/adr/parser-rq-source-region-partition.md.",
  "type": "object",
  "required": [
    "schema_version",
    "corpus_generation_algorithm",
    "coordinate_system",
    "status",
    "work_completeness"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "abc/parser-rq-source-recognition-aggregate/v1"
    },
    "qualification_identity_ref": {
      "$ref": "#/$defs/hash"
    },
    "corpus_generation_ref": {
      "$ref": "#/$defs/hash"
    },
    "corpus_generation_algorithm": {
      "const": "sha256-rfc8785-safe-integer-domain-abc-v1"
    },
    "policy_hash": {
      "$ref": "#/$defs/hash"
    },
    "membership_ref": {
      "$ref": "#/$defs/hash"
    },
    "coordinate_system": {
      "const": "decoded_utf8"
    },
    "status": {
      "enum": [
        "ok",
        "unavailable"
      ]
    },
    "work_completeness": {
      "$ref": "#/$defs/completeness"
    },
    "eligible_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "recognized_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "accounted_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "semantic_gap_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unaccounted_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "semantic_gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/work_interval"
      }
    },
    "unaccounted": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/work_interval"
      }
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "ok"
        },
        "work_completeness": {
          "properties": {
            "complete": {
              "const": true
            }
          }
        }
      },
      "required": [
        "qualification_identity_ref",
        "corpus_generation_ref",
        "policy_hash",
        "membership_ref",
        "eligible_bytes",
        "recognized_bytes",
        "accounted_bytes",
        "semantic_gap_bytes",
        "unaccounted_bytes",
        "semantic_gaps",
        "unaccounted"
      ],
      "not": {
        "required": [
          "errors"
        ]
      }
    },
    {
      "properties": {
        "status": {
          "const": "unavailable"
        }
      },
      "required": [
        "errors"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "eligible_bytes"
            ]
          },
          {
            "required": [
              "recognized_bytes"
            ]
          },
          {
            "required": [
              "accounted_bytes"
            ]
          },
          {
            "required": [
              "semantic_gap_bytes"
            ]
          },
          {
            "required": [
              "unaccounted_bytes"
            ]
          },
          {
            "required": [
              "semantic_gaps"
            ]
          },
          {
            "required": [
              "unaccounted"
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "work_interval": {
      "type": "object",
      "required": [
        "work_id",
        "start",
        "end"
      ],
      "additionalProperties": false,
      "properties": {
        "work_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "completeness": {
      "type": "object",
      "required": [
        "expected",
        "observed",
        "complete"
      ],
      "additionalProperties": false,
      "properties": {
        "expected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "complete": {
          "type": "boolean"
        }
      }
    }
  }
}
