{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/custom-parser-maintenance-evidence.schema.json",
  "title": "Custom parser quarterly maintenance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "status", "quarter", "period_start", "period_end", "recorded_at", "review_after", "expires_on", "focused_session", "categories", "observations", "trial_merge", "revisit_predicates"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "protocol_version": {"const": "1.0.0"},
    "status": {"enum": ["initial", "observed", "quarter_closed"]},
    "quarter": {"type": "string", "pattern": "^[0-9]{4}-Q[1-4]$"},
    "period_start": {"$ref": "#/$defs/date"},
    "period_end": {"$ref": "#/$defs/date"},
    "recorded_at": {"$ref": "#/$defs/date"},
    "review_after": {"$ref": "#/$defs/date"},
    "expires_on": {"$ref": "#/$defs/date"},
    "focused_session": {
      "type": "object", "additionalProperties": false,
      "required": ["duration_minutes", "rule"],
      "properties": {
        "duration_minutes": {"type": "integer", "minimum": 1},
        "rule": {"type": "string", "minLength": 1}
      }
    },
    "categories": {
      "type": "object", "additionalProperties": false,
      "required": ["upstream_review", "selective_ports", "security_review", "missed_fixes", "fork_only_defects", "planned_divergence", "remeasurement", "maintainer_availability"],
      "properties": {
        "upstream_review": {"$ref": "#/$defs/category"},
        "selective_ports": {"$ref": "#/$defs/category"},
        "security_review": {"$ref": "#/$defs/category"},
        "missed_fixes": {"$ref": "#/$defs/category"},
        "fork_only_defects": {"$ref": "#/$defs/category"},
        "planned_divergence": {"$ref": "#/$defs/category"},
        "remeasurement": {"$ref": "#/$defs/category"},
        "maintainer_availability": {"$ref": "#/$defs/category"}
      }
    },
    "observations": {
      "type": "object", "additionalProperties": false,
      "required": ["rolling_quarter_maintenance_minutes", "selective_port_samples_minutes", "selective_port_p90_minutes", "maximum_missed_fix_severity", "maintainer_available"],
      "properties": {
        "rolling_quarter_maintenance_minutes": {"type": "integer", "minimum": 0},
        "selective_port_samples_minutes": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "selective_port_p90_minutes": {"type": "integer", "minimum": 0},
        "maximum_missed_fix_severity": {"type": "integer", "minimum": 0, "maximum": 5},
        "maintainer_available": {"type": "boolean"}
      }
    },
    "trial_merge": {
      "type": "object", "additionalProperties": false,
      "required": ["procedure", "estimate", "benchmarks"],
      "properties": {
        "procedure": {"$ref": "#/$defs/procedure"},
        "estimate": {"$ref": "#/$defs/estimate"},
        "benchmarks": {"type": "array", "items": {"$ref": "#/$defs/benchmark"}}
      }
    },
    "revisit_predicates": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/predicate"}
    }
  },
  "$defs": {
    "date": {"type": "string", "format": "date"},
    "category": {
      "type": "object", "additionalProperties": false,
      "required": ["minutes", "notes"],
      "properties": {
        "minutes": {"type": "integer", "minimum": 0},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "procedure": {
      "type": "object", "additionalProperties": false,
      "required": ["upstream_repository", "upstream_revision", "fork_revision", "steps"],
      "properties": {
        "upstream_repository": {"type": "string", "format": "uri"},
        "upstream_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "fork_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "estimate": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_kind", "estimated_minutes", "components", "assumptions"],
      "properties": {
        "evidence_kind": {"const": "expert-assessment"},
        "estimated_minutes": {"type": "integer", "minimum": 0},
        "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/estimate_component"}},
        "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "estimate_component": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "minutes"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "minutes": {"type": "integer", "minimum": 0}
      }
    },
    "benchmark": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_kind", "metric", "scaled_integer", "unit", "command", "environment", "result_hash", "raw_artifact_path", "raw_artifact_hash"],
      "properties": {
        "evidence_kind": {"const": "benchmark"},
        "metric": {"type": "string", "minLength": 1},
        "scaled_integer": {"type": "integer", "minimum": 0},
        "unit": {"enum": ["milliseconds", "count", "bytes"]},
        "command": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "result_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "raw_artifact_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "raw_artifact_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["metric", "operator", "threshold", "action"],
          "properties": {
            "metric": {"enum": ["rolling_quarter_maintenance_minutes", "selective_port_p90_minutes", "maximum_missed_fix_severity"]},
            "operator": {"enum": [">", ">="]},
            "threshold": {"type": "integer", "minimum": 0},
            "action": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["metric", "operator", "threshold", "action"],
          "properties": {
            "metric": {"const": "maintainer_available"},
            "operator": {"const": "="},
            "threshold": {"type": "boolean"},
            "action": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
