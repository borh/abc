{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://w3id.org/soranoha/schemas/parser-rq-resource-aggregate.schema.json","title":"Parser RQ resource aggregate","type":"object","additionalProperties":false,
