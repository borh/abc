{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-diagnostic-gap-result.schema.json",
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "interval": {"type": "object", "required": ["start", "end"], "additionalProperties": false, "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}}, "blob": {"type": "object", "required": ["sha256", "bytes", "media_type", "locator"], "additionalProperties": false, "properties": {"sha256": {"$ref": "#/$defs/hash"}, "bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "media_type": {"const": "application/json"}, "locator": {"type": "string", "minLength": 1}}}, "source_recognition_evidence": {"type": "object", "required": ["relation", "artifact_ref", "value_hash", "qualification_identity_ref", "capture_generation_ref", "work_id"], "additionalProperties": false, "properties": {"relation": {"const": "partitions-semantic-gaps-of"}, "artifact_ref": {"$ref": "#/$defs/blob"}, "value_hash": {"$ref": "#/$defs/hash"}, "qualification_identity_ref": {"$ref": "#/$defs/hash"}, "capture_generation_ref": {"$ref": "#/$defs/hash"}, "work_id": {"type": "string", "minLength": 1}}}},
  "oneOf": [
    {"type": "object", "required": ["schema_version", "status", "work_id", "capture_generation_ref", "policy_hash", "source_recognition_evidence", "authorized_intervals", "silent_intervals", "authorized_bytes", "silent_bytes", "silent_drop_count"], "additionalProperties": false, "properties": {"schema_version": {"const": "abc/parser-rq-diagnostic-gap-result/v1"}, "status": {"const": "ok"}, "work_id": {"type": "string", "minLength": 1}, "capture_generation_ref": {"$ref": "#/$defs/hash"}, "policy_hash": {"$ref": "#/$defs/hash"}, "source_recognition_evidence": {"$ref": "#/$defs/source_recognition_evidence"}, "authorized_intervals": {"type": "array", "items": {"$ref": "#/$defs/interval"}}, "silent_intervals": {"type": "array", "items": {"$ref": "#/$defs/interval"}}, "authorized_bytes": {"type": "integer", "minimum": 0}, "silent_bytes": {"type": "integer", "minimum": 0}, "silent_drop_count": {"type": "integer", "minimum": 0}}},
    {"type": "object", "required": ["schema_version", "status", "work_id", "capture_generation_ref", "policy_hash", "unavailable_reasons"], "additionalProperties": false, "properties": {"schema_version": {"const": "abc/parser-rq-diagnostic-gap-result/v1"}, "status": {"const": "unavailable"}, "work_id": {"type": "string", "minLength": 1}, "capture_generation_ref": {"$ref": "#/$defs/hash"}, "policy_hash": {"$ref": "#/$defs/hash"}, "unavailable_reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}}}}
  ]
}
