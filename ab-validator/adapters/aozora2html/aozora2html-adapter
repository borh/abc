#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
GEM_NAME="aozora2html"
GEM_VERSION="3.0.1"
GEM_HOME_DIR="${AB_VALIDATOR_GEM_HOME:-/db/ab-validator/gems/aozora2html-$GEM_VERSION}"
AOZORA2HTML_BIN="${AB_AOZORA2HTML_BIN:-}"
RUST_MAPPER_BIN="${AB_AOZORA2HTML_MAPPER_BIN:-$REPO_ROOT/adapters/aozora2html/target/release/aozora2html-adapter}"
AOZORA2HTML_FLAKE="${REPO_ROOT}#aozora2html"

if [[ ! -x "$RUST_MAPPER_BIN" ]]; then
  echo "Rust mapper unavailable, build it with: just aozora2html-rust-build" >&2
  echo "Expected binary: $RUST_MAPPER_BIN" >&2
  exit 1
fi

if [[ "${1:-}" == "--version" ]]; then
  exec "$RUST_MAPPER_BIN" --version
fi

mode="aat"
if [[ "${1:-}" == "--mode" && $# -ge 2 ]]; then
  mode="$2"
fi

tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT INT TERM
stdin_raw="$tmp_dir/stdin.raw"
parser_sjis_src="$tmp_dir/parser.sjis"
crlf_src="$tmp_dir/crlf.txt"
xhtml="$tmp_dir/out.html"

cat > "$stdin_raw"

# aozora2html requires Shift_JIS input with CRLF line endings (lib/aozora2html.rb:157
# hardcodes 'rb:Shift_JIS'). Detect input encoding, transcode to Shift_JIS if
# needed, then normalize line endings.
sjis_src="$tmp_dir/sjis.sjis"

if head -c 3 "$stdin_raw" | od -An -tx1 | tr -d ' \n' | grep -q '^efbbbf'; then
  tail -c +4 "$stdin_raw" | iconv -f UTF-8 -t CP932 > "$sjis_src"
elif iconv -f UTF-8 -t CP932 "$stdin_raw" > "$sjis_src" 2>/dev/null; then
  : # input was UTF-8, transcoded to Shift_JIS
else
  cp "$stdin_raw" "$sjis_src"  # assume already Shift_JIS
fi

if grep -a -q -- '--------------------' "$sjis_src"; then
  cp "$sjis_src" "$parser_sjis_src"
else
  printf 'テスト\n著者\n\n-------------------------------------------------------\n凡例\n-------------------------------------------------------\n' \
    | iconv -f UTF-8 -t CP932 > "$parser_sjis_src"
  cat "$sjis_src" >> "$parser_sjis_src"
  printf '\n底本：テスト\n' | iconv -f UTF-8 -t CP932 >> "$parser_sjis_src"
fi

perl -pe 's/\r?\n?$/\r\n/' "$parser_sjis_src" > "$crlf_src"

parser_err="$tmp_dir/parser.err"

# Ruby parser may abort partway through (CRLF errors, JIS-out-of-range, etc.).
# Capture its exit and let the Rust mapper emit a parse_complete=false envelope so
# ab-check sees a valid AAT instead of empty stdout.
run_aozora2html_parser() {
  if [[ -n "$AOZORA2HTML_BIN" ]]; then
    "$AOZORA2HTML_BIN" --error-utf8 --use-unicode "$crlf_src" "$xhtml"
    return
  fi

  nix develop "$AOZORA2HTML_FLAKE" --command bash -lc \
    "set -euo pipefail
     export GEM_HOME='$GEM_HOME_DIR'
     export GEM_PATH='$GEM_HOME_DIR'
     export PATH='$GEM_HOME_DIR/bin':\$PATH
     if ! gem list --installed --exact '$GEM_NAME' --version '$GEM_VERSION' >/dev/null; then
       mkdir -p '$GEM_HOME_DIR'
       gem install --no-document --install-dir '$GEM_HOME_DIR' --version '$GEM_VERSION' '$GEM_NAME'
     fi
     aozora2html --error-utf8 --use-unicode '$crlf_src' '$xhtml'"
}

parser_rc=0
run_aozora2html_parser >"$parser_err" 2>&1 || parser_rc=$?
cat "$parser_err" >&2

parse_complete_arg=()
mode_arg=()
if [[ "$parser_rc" -ne 0 ]]; then
  parse_complete_arg=(--parser-failed --parser-error-file "$parser_err")
fi
mode_arg=(--mode "$mode")

# Rust mapper reads --source for hash/encoding metadata. Pass the original
# stdin bytes so source_hash matches what other adapters see.
common_args=(--source "$stdin_raw" --xhtml "$xhtml" "${mode_arg[@]}" "${parse_complete_arg[@]}")
"$RUST_MAPPER_BIN" "${common_args[@]}"
