{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-publication-policy.schema.json",
  "title": "Parser RQ publication policy",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "policy_id",
    "policy_hash",
    "structure_checks",
    "supporting_checks",
    "preservation_schema",
    "validator"
  ],
  "properties": {
    "schema_id": {
      "const": "https://w3id.org/abc/schemas/parser-rq-publication-policy.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_hash": {
      "$ref": "#/$defs/hash"
    },
    "structure_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supporting_checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "preservation_schema": {
      "$ref": "#/$defs/authority"
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "semantics_hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "semantics_hash": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  }
}
