{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/pack-policy.schema.json",
  "title": "ABC Pack Policy",
  "version": "0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_hash",
    "policy_id",
    "policy_version",
    "pack_kind",
    "included_artifact_kinds",
    "included_sidecar_roles",
    "pack_index_output_format_spec_hash",
    "metric_table_output_format_spec_hashes",
    "locator_policy",
    "compression_policy",
    "row_group_policy",
    "missing_artifact_behavior"
  ],
  "properties": {
    "schema_id": {
      "const": "https://w3id.org/abc/schemas/pack-policy.schema.json"
    },
    "schema_hash": { "$ref": "#/$defs/hash" },
    "policy_id": { "type": "string", "minLength": 1 },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "pack_kind": {
      "enum": ["none", "parquet-pack-v1", "archive-index-v1"]
    },
    "included_artifact_kinds": {
      "type": "array",
      "items": {
        "enum": [
          "source",
          "metadata-record",
          "parser-ir",
          "tei",
          "plaintext",
          "tokenized",
          "analysis",
          "failure"
        ]
      },
      "uniqueItems": true
    },
    "included_sidecar_roles": {
      "type": "array",
      "items": {
        "enum": [
          "warnings",
          "errors",
          "validation-result",
          "rdf-view",
          "index-entry",
          "mapping-divergence",
          "preservation",
          "source-region-coverage",
          "analysis-result",
          "token-stream"
        ]
      },
      "uniqueItems": true
    },
    "pack_index_output_format_spec_hash": { "$ref": "#/$defs/nullableHash" },
    "metric_table_output_format_spec_hashes": {
      "type": "array",
      "items": { "$ref": "#/$defs/hash" },
      "uniqueItems": true
    },
    "locator_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["none", "relative-path", "archive-member"] }
      }
    },
    "compression_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": { "enum": ["none", "zstd"] },
        "zstd_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 22
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "method": { "const": "none" } },
            "required": ["method"]
          },
          "then": { "not": { "required": ["zstd_level"] } }
        },
        {
          "if": {
            "properties": { "method": { "const": "zstd" } },
            "required": ["method"]
          },
          "then": { "required": ["zstd_level"] }
        }
      ]
    },
    "row_group_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["none", "target-rows"] },
        "target_rows": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "none" } },
            "required": ["mode"]
          },
          "then": { "not": { "required": ["target_rows"] } }
        },
        {
          "if": {
            "properties": { "mode": { "const": "target-rows" } },
            "required": ["mode"]
          },
          "then": { "required": ["target_rows"] }
        }
      ]
    },
    "missing_artifact_behavior": {
      "enum": ["reject-pack", "record-missing-status"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "pack_kind": { "const": "none" } },
        "required": ["pack_kind"]
      },
      "then": {
        "properties": {
          "included_artifact_kinds": { "maxItems": 0 },
          "included_sidecar_roles": { "maxItems": 0 },
          "metric_table_output_format_spec_hashes": { "maxItems": 0 },
          "pack_index_output_format_spec_hash": { "type": "null" },
          "locator_policy": {
            "properties": { "mode": { "const": "none" } }
          },
          "compression_policy": {
            "properties": { "method": { "const": "none" } }
          },
          "row_group_policy": {
            "properties": { "mode": { "const": "none" } }
          },
          "missing_artifact_behavior": {
            "const": "record-missing-status"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "pack_kind": { "not": { "const": "none" } } },
        "required": ["pack_kind"]
      },
      "then": {
        "properties": {
          "pack_index_output_format_spec_hash": { "$ref": "#/$defs/hash" }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableHash": {
      "anyOf": [
        { "$ref": "#/$defs/hash" },
        { "type": "null" }
      ]
    }
  }
}
