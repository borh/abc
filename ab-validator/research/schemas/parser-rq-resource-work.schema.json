{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://w3id.org/abc/schemas/parser-rq-resource-work.schema.json","title":"Parser RQ resource work","type":"object","additionalProperties":false,
  "required":["schema_id","schema_version","work_id","source_sha256","qualification_identity_ref","policy_hash","status"],
  "properties":{"schema_id":{"const":"https://w3id.org/abc/schemas/parser-rq-resource-work.schema.json"},"schema_version":{"const":"1.0.0"},"work_id":{"type":"string","minLength":1},"source_sha256":{"$ref":"#/$defs/hash"},"qualification_identity_ref":{"$ref":"#/$defs/hash"},"policy_hash":{"$ref":"#/$defs/hash"},"status":{"enum":["measured","ceiling_clipped","unavailable"]},"peak_cgroup_memory_bytes":{"type":"integer","minimum":0},"peak_swap_bytes":{"type":"integer","minimum":0},"right_censored":{"type":"boolean"},"oom_kill":{"type":"boolean"},"reason":{"enum":["counter_unavailable","counter_invalid","identity_mismatch","lingering_descendant","unexpected_oom","command_failed","index_incomplete"]},"details":{"type":"object"}},
  "allOf":[
