{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-evaluation-index.schema.json",
  "title": "Parser RQ evaluation generation index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "evaluation_generation_ref", "candidate_ref", "qualification_identity_ref", "capture_generation_ref", "registry_ref", "members"],
  "properties": {
    "schema_id": {"const": "https://w3id.org/abc/schemas/parser-rq-evaluation-index.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "evaluation_generation_ref": {"$ref": "#/$defs/hash"},
    "candidate_ref": {"$ref": "#/$defs/hash"},
    "qualification_identity_ref": {"$ref": "#/$defs/hash"},
    "capture_generation_ref": {"$ref": "#/$defs/hash"},
    "registry_ref": {"$ref": "#/$defs/hash"},
    "members": {
      "type": "object", "additionalProperties": false,
      "required": ["admission_candidate", "admission_report", "qualification_report"],
      "properties": {
        "admission_candidate": {"$ref": "#/$defs/blob"},
        "admission_report": {"$ref": "#/$defs/blob"},
        "qualification_report": {"$ref": "#/$defs/blob"}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "blob": {"type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "media_type", "locator"], "properties": {"sha256": {"$ref": "#/$defs/hash"}, "bytes": {"type": "integer", "minimum": 0}, "media_type": {"type": "string", "minLength": 1}, "locator": {"$ref": "#/$defs/locator"}}},
    "locator": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
  }
}
