# Local research corpora and parser checkouts
references/
.direnv/
target/
adapters/*/target/
result
result-*
__pycache__/
*.pyc

# Local scratch directory for benchmark/run outputs (kept out of /tmp/)
scratch/

# Flake-backed dictionary build outputs. Keep only the directory anchors.
dictionary/compiled/*
!dictionary/compiled/.gitkeep
dictionary/compiled/.cache/
dictionary/optimized/*
!dictionary/optimized/.gitkeep

# Local worktrees (isolated workspaces)
.worktrees/

# Local tool state
.cargo/.*
.cargo/git/
.cargo/registry/
.claude/settings.local.json
