{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc.local/schemas/aat-v2.json",
  "type": "object",
  "required": ["version", "work_id", "blocks", "meta"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 2 },
    "work_id": { "type": "string" },
    "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
    "meta": { "$ref": "#/$defs/meta" }
  },
  "$defs": {
    "sourceSpan":{"type":"object","additionalProperties":false,"required":["start","end","coordinate_system"],"properties":{"start":{"type":"integer","minimum":0},"end":{"type":"integer","minimum":0},"line":{"type":"integer","minimum":1},"coordinate_system":{"const":"decoded_utf8"}}},
    "relativePlacement": {
      "type":"object", "additionalProperties":false,
      "required":["relation","anchor_kind","anchor_span"],
      "properties":{
        "relation":{"const":"below"}, "anchor_kind":{"enum":["text","horizontal-block"]},
        "anchor_span":{"$ref":"#/$defs/sourceSpan"},
        "offset_chars":{"type":"integer","minimum":0,"maximum":255,"description":"Supplied fullwidth-character distance from the anchor lower edge."}
      },
      "allOf":[{"if":{"properties":{"anchor_kind":{"const":"text"}}},"then":{"required":["offset_chars"]},"else":{"not":{"required":["offset_chars"]}}}]
    },

    "interpretationFact": {"type":"object","additionalProperties":false,"required":["kind","outcome","aspects","source_span"],"properties":{"kind":{"enum":["ruby","gaiji","gaiji-ruby","iteration-mark","supplied-diacritic","illustration","baseline-position","exponent","emphasis","warichu","kunten","heading","caption","translation","text-variant","annotated-text","layout","editorial-note","line-layout","formula","table","layout-break","external-table-reference","glyph-shape-assertion","supplied-mark","quotation","letter"]},"outcome":{"const":"established"},"aspects":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["content","structure","layout"]}},"source_span":{"$ref":"#/$defs/sourceSpan"}}},
    "span": {
      "type": "object",
      "required": ["line_start", "line_end", "byte_start", "byte_end"],
