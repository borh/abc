      "properties": {
        "interpretation_marker_spans": { "type": "array", "items": { "$ref": "#/$defs/span" } },
        "kind": { "enum": ["style", "formatting", "font_size", "small_script", "baseline_position", "chitsuki", "exponent", "tcy", "keigakomi", "yokogumi", "caption", "fraction"] },
        "border": {"enum":["rule","unspecified","dashed-rule","box","circle","dotted-circle","double-rule"]},
        "decoration": {"type":"object", "additionalProperties":false, "required":["kind","position"], "properties":{"kind":{"type":"string"}, "position":{"enum":["right","left","both","unknown"]}}},
        "attributes": { "type":"array", "minItems":2, "uniqueItems":true, "items": { "$ref":"#/$defs/formatting_attribute" } },
        "style_type": { "type": "string" },
        "size_type": { "enum": ["large", "small", "absolute", "qualitative"] },
        "direction": { "enum": ["larger", "smaller"] },
        "qualifier": { "enum": ["やや", "ひとまわり"] },
        "level": { "type": "integer", "minimum": 1 },
        "size": { "enum": ["extra-large", "large", "medium", "small"] },
        "position": { "enum": ["right", "left", "lowered"] },
        "class_name": { "type": "string" },
        "align": { "const": "right" },
        "offset_from_end": { "type": "integer", "minimum": 0 },
        "indent_first": { "type": "integer", "minimum": 0 },
        "indent_rest": { "type": "integer", "minimum": 0 },
        "span": { "$ref": "#/$defs/span" },
        "content": { "type": "array", "items": { "$ref": "#/$defs/inline" } }
      },
      "allOf": [
        {"if":{"properties":{"kind":{"const":"chitsuki"}}},"then":{"required":["align","offset_from_end"]}},
        {"if":{"properties":{"kind":{"const":"baseline_position"}}},"then":{"required":["position"],"properties":{"position":{"const":"lowered"}}}},
        {"if":{"properties":{"kind":{"enum":["baseline_position","exponent"]}}},"then":{"not":{"anyOf":[{"required":["level"]},{"required":["size"]},{"required":["size_type"]}]}}},
        { "if":{"properties":{"kind":{"const":"formatting"}}}, "then":{"required":["attributes"]}, "else":{"not":{"required":["attributes"]}} },
        {
          "if": { "properties": { "kind": { "const": "small_script" } } },
          "then": { "required": ["position"], "properties":{"position":{"enum":["right","left"]}} }
        },
        {
          "if": { "properties": { "kind": { "const": "font_size" } } },
          "then": {
            "required": ["size_type"],
            "oneOf": [
              { "properties": { "size_type": { "enum": ["large", "small"] } }, "required": ["level"], "not": { "anyOf": [{"required":["size"]},{"required":["direction"]},{"required":["qualifier"]}] } },
              { "properties": { "size_type": { "const": "absolute" } }, "required": ["size"], "not": { "anyOf": [{"required":["level"]},{"required":["direction"]},{"required":["qualifier"]}] } },
              { "properties": { "size_type": { "const": "qualitative" } }, "required": ["direction"], "not": { "anyOf": [{"required":["level"]},{"required":["size"]}] } }
            ]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "style" }, "style_type": { "const": "chitsuki" } },
            "required": ["style_type"]
          },
          "then": { "required": ["align", "offset_from_end"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "style" }, "style_type": { "const": "burasage" } },
            "required": ["style_type"]
          },
          "then": { "required": ["indent_first", "indent_rest"] }
        }
      ]
    },
    "suppliedDiacritic": {
      "type":"object", "additionalProperties":false, "patternProperties":{"^x-":true},
      "required":["kind","text","source","span","interpretation_marker_spans"],
      "properties":{"kind":{"const":"supplied-diacritic"}, "text":{"type":"string","minLength":1},
        "source":{"type":"string","minLength":1}, "span":{"$ref":"#/$defs/span"},
        "interpretation_marker_spans":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/span"}}}
    },
    "iterationMark": {
      "type":"object", "additionalProperties":false,
      "required":["kind","text","source","span"],
      "properties":{"kind":{"const":"iteration-mark"}, "text":{"enum":["〱","〲"]},
        "source":{"enum":["／＼","／″＼"]}, "span":{"$ref":"#/$defs/span"}},
      "oneOf":[{"properties":{"text":{"const":"〱"},"source":{"const":"／＼"}}},
               {"properties":{"text":{"const":"〲"},"source":{"const":"／″＼"}}}]
    },
    "kunten": {
      "type":"object", "additionalProperties":false,
      "required":["kind","kunten_kind","text","span"],
      "properties":{"kind":{"const":"kunten"}, "kunten_kind":{"enum":["return-mark","okurigana"]},
        "text":{"type":"string","minLength":1}, "span":{"$ref":"#/$defs/span"},
        "interpretation_marker_spans":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/span"}}}
    },
    "warichu": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "content", "span"],
      "properties": {"interpretation_marker_spans": {"type":"array", "items":{"$ref":"#/$defs/span"}}, "kind": {"const": "warichu"}, "span": {"$ref": "#/$defs/span"},
        "content": {"type": "array", "items": {"$ref": "#/$defs/inline"}}}
    },
    "warigaki": {
      "type": "object",
      "required": ["kind", "upper", "lower"],
      "additionalProperties": false,
      "patternProperties": { "^x-": true },
      "properties": {
        "kind": { "const": "warigaki" },
        "span": { "$ref": "#/$defs/span" },
        "upper": { "type": "array", "items": { "$ref": "#/$defs/inline" } },
        "lower": { "type": "array", "items": { "$ref": "#/$defs/inline" } }
      }
    }
  }
}
