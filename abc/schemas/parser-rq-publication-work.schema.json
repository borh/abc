{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://w3id.org/abc/schemas/parser-rq-publication-work.schema.json","title":"Parser RQ publication work","version":"1.0.0","type":"object","additionalProperties":false,"required":["schema_id","schema_version","work_id","source_sha256","qualification_identity_ref","parser_disposition","policy_hash","preservation_schema_hash","validator_semantics_hash","census_hash"],"properties":{"schema_id":{"const":"https://w3id.org/abc/schemas/parser-rq-publication-work.schema.json"},"schema_version":{"const":"1.0.0"},"work_id":{"type":"string","minLength":1},"source_sha256":{"$ref":"#/$defs/hash"},"qualification_identity_ref":{"$ref":"#/$defs/hash"},"parser_disposition":{"enum":["parsed","failed","timeout"]},"policy_hash":{"$ref":"#/$defs/hash"},"preservation_schema_hash":{"$ref":"#/$defs/hash"},"validator_semantics_hash":{"$ref":"#/$defs/hash"},"census_hash":{"$ref":"#/$defs/hash"},"publication":{"type":"object"},"failure":{"type":"object"}},"allOf":[{"if":{"properties":{"parser_disposition":{"const":"parsed"}}},"then":{"required":["publication"],"not":{"required":["failure"]}},"else":{"required":["failure"],"not":{"required":["publication"]}}}],"$defs":{"hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}
