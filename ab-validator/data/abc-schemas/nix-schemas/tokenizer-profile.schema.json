{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/tokenizer-profile.schema.json",
  "title": "ABC Tokenizer Profile",
  "version": "0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_hash",
    "profile_id",
    "profile_version",
    "tokenizer",
    "dictionary",
    "input_normalization_policy_hash",
    "locale",
    "encoding",
    "thread_policy",
    "token_granularity",
    "token_output_schema_hash",
    "determinism_tier",
    "fixture_evidence_hash"
  ],
  "properties": {
    "schema_id": {
      "const": "https://w3id.org/abc/schemas/tokenizer-profile.schema.json"
    },
    "schema_hash": { "$ref": "#/$defs/hash" },
    "profile_id": { "type": "string", "minLength": 1 },
    "profile_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "tokenizer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "build_hash",
        "build_options_hash"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "build_hash": { "$ref": "#/$defs/hash" },
        "build_options_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "dictionary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "archive_hash",
        "build_options_hash",
        "license"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "archive_hash": { "$ref": "#/$defs/hash" },
        "build_options_hash": { "$ref": "#/$defs/hash" },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "input_normalization_policy_hash": { "$ref": "#/$defs/hash" },
    "locale": { "type": "string", "minLength": 1 },
    "encoding": { "type": "string", "minLength": 1 },
    "thread_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["single-thread", "deterministic-parallel"] },
        "max_threads": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "single-thread" } },
            "required": ["mode"]
          },
          "then": {
            "not": { "required": ["max_threads"] }
          }
        },
        {
          "if": {
            "properties": { "mode": { "const": "deterministic-parallel" } },
            "required": ["mode"]
          },
          "then": { "required": ["max_threads"] }
        }
      ]
    },
    "token_granularity": {
      "enum": ["short-unit-word", "long-unit-word", "sentence"]
    },
    "token_output_schema_hash": { "$ref": "#/$defs/hash" },
    "determinism_tier": {
      "enum": ["exact", "stable", "bounded", "exploratory"]
    },
    "fixture_evidence_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
