{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-site-descriptor.schema.json",
  "title": "Parser RQ untracked runtime places",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "corpus_root", "evidence_store_root", "scratch_root", "campaign_lock_path"],
  "properties": {
    "schema_id": {"const": "https://w3id.org/abc/schemas/parser-rq-site-descriptor.schema.json"},
    "schema_version": {"const": "2.0.0"},
    "corpus_root": {"$ref": "#/$defs/path"},
    "evidence_store_root": {"$ref": "#/$defs/path"},
    "scratch_root": {"$ref": "#/$defs/path"},
    "campaign_lock_path": {"$ref": "#/$defs/path"}
  },
  "$defs": {"path": {"type": "string", "pattern": "^/", "minLength": 2}}
}
