# Copy to .soranoha/env or ${XDG_CONFIG_HOME:-$HOME/.config}/soranoha/env.
# Explicit shell environment variables override this file.

# Machine-local durable state root. Large corpora, AAT batches, and generated
# reports may live here instead of in the Git checkout.
export SORANOHA_STATE_ROOT="$HOME/.local/state/soranoha"

# Generated reports. Defaults to "$SORANOHA_WORKSPACE_ROOT/out/reports".
# export SORANOHA_REPORT_DIR="$SORANOHA_STATE_ROOT/reports"

# Optional TEI P5 checkout override. Nix shells expose the pinned flake input,
# but local ad-hoc scripts can use this when needed.
# export AB_TEI_P5_ROOT="/path/to/TEI/P5"
