@prefix abc: <https://w3id.org/abc/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdag2: <http://RDVocab.info/ElementsGr2/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

abc:ArtifactShape
  a sh:NodeShape ;
  sh:targetClass abc:Artifact ;
  sh:property [
    sh:path abc:artifactId ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^sha256:[0-9a-f]{64}$"
  ] ;
  sh:property [
    sh:path abc:schemaHash ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^sha256:[0-9a-f]{64}$"
  ] ;
  sh:property [
    sh:path abc:validationStatus ;
    sh:minCount 1 ;
    sh:in ("not-run" "passed" "warning" "failed")
  ] ;
  sh:property [
    sh:path prov:wasGeneratedBy ;
    sh:minCount 1 ;
    sh:class prov:Activity
  ] ;
  sh:property [
    sh:path prov:wasDerivedFrom ;
    sh:minCount 1
  ] ;
  sh:or (
    [
      sh:property [
        sh:path abc:contentHash ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^sha256:[0-9a-f]{64}$"
      ] ;
      sh:property [
        sh:path dcterms:format ;
        sh:minCount 1 ;
        sh:datatype xsd:string
      ]
    ]
    [
      sh:class abc:FailureArtifact
    ]
  ) .

abc:ActivityShape
  a sh:NodeShape ;
  sh:targetClass prov:Activity ;
  sh:property [
    sh:path prov:used ;
    sh:minCount 1
  ] ;
  sh:property [
    sh:path prov:qualifiedAssociation ;
    sh:minCount 1
  ] .

abc:FailureShape
  a sh:NodeShape ;
  sh:targetClass abc:FailureArtifact ;
  sh:property [
    sh:path abc:validationStatus ;
    sh:hasValue "failed"
  ] ;
  sh:property [
    sh:path abc:hasErrorArtifact ;
    sh:minCount 1
  ] .

# ArtifactShape's sh:or discriminates the artifact subtype (content+format
# vs. FailureArtifact) but does not duplicate per-subtype property checks.
# FailureShape above is the single source of truth for what a FailureArtifact
# must carry.

abc:SidecarShape
  a sh:NodeShape ;
  sh:targetObjectsOf abc:hasSidecar ;
  sh:property [
    sh:path abc:sidecarRole ;
    sh:minCount 1 ;
    sh:datatype xsd:string
  ] ;
  sh:property [
    sh:path abc:contentHash ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^sha256:[0-9a-f]{64}$"
  ] ;
  sh:property [
    sh:path dcterms:format ;
    sh:minCount 1 ;
    sh:datatype xsd:string
  ] .

# Metadata-record shapes target the bibliographic-data RDF view produced
# by abc.tools.metadata-record/record->graph. They constrain not only
# presence but also datatype and (where the source data is enum-bound)
# value-set membership, so identity-affecting drift in the JSON record
# surfaces as a SHACL failure rather than passing through silently.

abc:MetadataRecordWorkShape
  a sh:NodeShape ;
  sh:targetClass bibo:Document ;
  sh:property [
    sh:path dcterms:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:int
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path dc:subject ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path abc:orthographicStyle ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:in ("新字新仮名" "新字旧仮名" "旧字新仮名" "旧字旧仮名" "その他")
  ] ;
  sh:property [
    sh:path abc:copyrightExpired ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:boolean
  ] ;
  sh:property [
    sh:path dcterms:available ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:date
  ] ;
  sh:property [
    sh:path dcterms:modified ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:date
  ] ;
  sh:property [
    sh:path dcterms:creator ;
    sh:minCount 1
  ] .

abc:PersonRecordShape
  a sh:NodeShape ;
  sh:targetClass foaf:Person ;
  sh:property [
    sh:path dcterms:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:int
  ] ;
  sh:property [
    sh:path foaf:familyName ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string
  ] ;
  sh:property [
    sh:path foaf:givenName ;
    sh:maxCount 1 ;
    sh:datatype xsd:string
  ] ;
  sh:property [
    sh:path foaf:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string
  ] ;
  sh:property [
    sh:path rdag2:dateOfBirth ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYearMonth ]
      [ sh:datatype xsd:gYear ]
    )
  ] ;
  sh:property [
    sh:path rdag2:dateOfDeath ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYearMonth ]
      [ sh:datatype xsd:gYear ]
    )
  ] ;
  sh:property [
    sh:path abc:edtfDateOfBirth ;
    sh:maxCount 1 ;
    sh:datatype abc:EDTF ;
    sh:pattern "^(-?\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?|-?\\d{3}X|-?\\d{2}XX)$"
  ] ;
  sh:property [
    sh:path abc:edtfDateOfDeath ;
    sh:maxCount 1 ;
    sh:datatype abc:EDTF ;
    sh:pattern "^(-?\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?|-?\\d{3}X|-?\\d{2}XX)$"
  ] .
