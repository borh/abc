{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-diagnostic-gap-result.schema.json",
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "interval": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "blob": {
      "type": "object",
      "required": [
        "sha256",
        "bytes",
        "media_type",
        "locator"
      ],
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "bytes": {
          "$ref": "#/$defs/count"
        },
        "media_type": {
          "const": "application/json"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_recognition_evidence": {
      "type": "object",
      "required": [
        "relation",
        "artifact_ref",
        "value_hash",
        "qualification_identity_ref",
        "capture_generation_ref",
        "work_id"
      ],
      "additionalProperties": false,
      "properties": {
        "relation": {
          "const": "partitions-semantic-gaps-of"
        },
        "artifact_ref": {
          "$ref": "#/$defs/blob"
        },
        "value_hash": {
          "$ref": "#/$defs/hash"
        },
        "qualification_identity_ref": {
          "$ref": "#/$defs/hash"
        },
        "capture_generation_ref": {
          "$ref": "#/$defs/hash"
        },
        "work_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "diagnostic_authorization_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decoded_source_hash",
        "raw_diagnostics_hash",
        "raw_diagnostics_bytes",
          "policy_hash",
          "policy_artifact_hash",
          "policy_artifact_bytes",
        "source_recognition_hash"
      ],
      "properties": {
        "decoded_source_hash": {
          "$ref": "#/$defs/hash"
        },
        "raw_diagnostics_hash": {
          "$ref": "#/$defs/hash"
        },
        "raw_diagnostics_bytes": {
          "$ref": "#/$defs/count"
        },
        "policy_hash": {
          "$ref": "#/$defs/hash"
        },
        "policy_artifact_hash": {
          "$ref": "#/$defs/hash"
        },
        "policy_artifact_bytes": {
          "$ref": "#/$defs/count"
        },
        "source_recognition_hash": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "work_id",
        "capture_generation_ref",
        "qualification_identity_ref",
        "policy_hash",
        "source_recognition_evidence",
        "diagnostic_authorization_evidence",
        "authorized_intervals",
        "silent_intervals",
        "authorized_bytes",
        "silent_bytes",
        "silent_drop_count",
        "diagnostic_count",
        "authorizing_diagnostic_count",
        "observe_only_diagnostic_count",
        "vacuous"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "abc/parser-rq-diagnostic-gap-result/v1"
        },
        "status": {
          "const": "ok"
        },
        "work_id": {
          "type": "string",
          "minLength": 1
        },
        "capture_generation_ref": {
          "$ref": "#/$defs/hash"
        },
        "qualification_identity_ref": {
          "$ref": "#/$defs/hash"
        },
        "policy_hash": {
          "$ref": "#/$defs/hash"
        },
        "source_recognition_evidence": {
          "$ref": "#/$defs/source_recognition_evidence"
        },
        "diagnostic_authorization_evidence": {
          "$ref": "#/$defs/diagnostic_authorization_evidence"
        },
        "authorized_intervals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interval"
          }
        },
        "silent_intervals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interval"
          }
        },
        "authorized_bytes": {
          "$ref": "#/$defs/count"
        },
        "silent_bytes": {
          "$ref": "#/$defs/count"
        },
        "silent_drop_count": {
          "$ref": "#/$defs/count"
        },
        "diagnostic_count": {
          "$ref": "#/$defs/count"
        },
        "authorizing_diagnostic_count": {
          "$ref": "#/$defs/count"
        },
        "observe_only_diagnostic_count": {
          "$ref": "#/$defs/count"
        },
        "vacuous": {
          "type": "boolean"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "work_id",
        "capture_generation_ref",
        "policy_hash",
        "unavailable_reasons"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "abc/parser-rq-diagnostic-gap-result/v1"
        },
        "status": {
          "const": "unavailable"
        },
        "work_id": {
          "type": "string",
          "minLength": 1
        },
        "capture_generation_ref": {
          "$ref": "#/$defs/hash"
        },
        "policy_hash": {
          "$ref": "#/$defs/hash"
        },
        "unavailable_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      }
    }
  ]
}
