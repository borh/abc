{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-capture-authorization.schema.json",
  "title": "Parser RQ capture authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "authorization_ref", "authorization_ordinal", "candidate_ref", "qualification_identity_ref", "readiness_receipt_ref", "not_before_utc", "not_after_utc", "repetitions", "reduction"],
  "properties": {
    "schema_id": {"const": "https://w3id.org/abc/schemas/parser-rq-capture-authorization.schema.json"},
    "schema_version": {"const": "3.0.0"},
    "authorization_ref": {"$ref": "#/$defs/hash"},
    "authorization_ordinal": {"const": 1},
    "candidate_ref": {"$ref": "#/$defs/hash"},
    "qualification_identity_ref": {"$ref": "#/$defs/hash"},
    "readiness_receipt_ref": {"$ref": "#/$defs/hash"},
    "not_before_utc": {"type": "string", "format": "date-time"},
    "not_after_utc": {"type": "string", "format": "date-time"},
    "repetitions": {"const": 3},
    "reduction": {"const": "maximum"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
