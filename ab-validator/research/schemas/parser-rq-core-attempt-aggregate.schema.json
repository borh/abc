{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-core-attempt-aggregate.schema.json",
  "title": "Parser RQ core attempt aggregate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "qualification_identity_ref", "candidate_ref", "policy_hash", "status", "work_count", "repetition_count"],
  "properties": {
    "schema_id": {"const": "https://w3id.org/abc/schemas/parser-rq-core-attempt-aggregate.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "qualification_identity_ref": {"$ref": "#/$defs/hash"},
    "candidate_ref": {"$ref": "#/$defs/hash"},
    "policy_hash": {"$ref": "#/$defs/hash"},
    "status": {"enum": ["measured", "protocol_error", "unavailable"]},
    "work_count": {"type": "integer", "minimum": 1},
    "repetition_count": {"const": 3},
    "fatal_failures": {"type": "number", "minimum": 0},
    "wall_time_seconds": {"type": "number", "minimum": 0},
    "timeouts": {"type": "number", "minimum": 0},
    "repetition_values": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["repetition", "fatal_failures", "wall_time_seconds", "timeouts"], "properties": {"repetition": {"type": "integer", "minimum": 1, "maximum": 3}, "fatal_failures": {"type": "integer", "minimum": 0}, "wall_time_seconds": {"type": "number", "minimum": 0}, "timeouts": {"type": "integer", "minimum": 0}}}},
    "reason": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "measured"}}}, "then": {"required": ["fatal_failures", "wall_time_seconds", "timeouts", "repetition_values"], "not": {"required": ["reason"]}}},
    {"if": {"properties": {"status": {"enum": ["protocol_error", "unavailable"]}}}, "then": {"required": ["reason"], "not": {"anyOf": [{"required": ["fatal_failures"]}, {"required": ["wall_time_seconds"]}, {"required": ["timeouts"]}, {"required": ["repetition_values"]}]}}}
  ],
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
