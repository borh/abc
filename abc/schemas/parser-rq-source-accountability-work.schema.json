{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-source-accountability-work.schema.json",
  "title": "Parser release qualification source-accountability work record",
  "type": "object",
  "required": ["schema_version", "identity_ref", "instrument_version", "work_id", "original_source", "decoded_source", "parser_ir", "diagnostics", "taxonomy_version", "taxonomy_hash", "coordinate_system", "coverage_basis", "status", "ignored", "eligible", "covered_eligible", "uncovered_eligible", "decoded_source_bytes", "ignored_bytes", "eligible_bytes", "covered_eligible_bytes", "uncovered_eligible_bytes", "errors"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "abc/parser-rq-source-accountability-work/v1"},
    "identity_ref": {"$ref": "#/$defs/hash"},
    "instrument_version": {"type": "string", "minLength": 1},
    "work_id": {"type": "string", "minLength": 1},
    "original_source": {"$ref": "#/$defs/blob"},
    "decoded_source": {"$ref": "#/$defs/decoded_blob"},
    "parser_ir": {"$ref": "#/$defs/parser_ir_blob"},
    "diagnostics": {"$ref": "#/$defs/logical_blob"},
    "taxonomy_version": {"const": "parser-rq-ignored-regions-v1"},
    "taxonomy_hash": {"$ref": "#/$defs/hash"},
    "coordinate_system": {"const": "decoded_utf8"},
    "coverage_basis": {"const": "parser_ir.nodes[*].span"},
    "status": {"enum": ["ok", "unavailable"]},
    "ignored": {"$ref": "#/$defs/intervals"},
    "eligible": {"$ref": "#/$defs/intervals"},
    "covered_eligible": {"$ref": "#/$defs/intervals"},
    "uncovered_eligible": {"$ref": "#/$defs/intervals"},
    "decoded_source_bytes": {"type": "integer", "minimum": 0},
    "ignored_bytes": {"type": "integer", "minimum": 0},
    "eligible_bytes": {"type": "integer", "minimum": 0},
    "covered_eligible_bytes": {"type": "integer", "minimum": 0},
    "uncovered_eligible_bytes": {"type": "integer", "minimum": 0},
    "errors": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ok"}}},
      "then": {"properties": {"errors": {"maxItems": 0}}},
      "else": {"properties": {"errors": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "interval": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0}
      }
    },
    "intervals": {"type": "array", "items": {"$ref": "#/$defs/interval"}},
    "blob": {
      "type": "object",
      "required": ["sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "sha256": {"$ref": "#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "decoded_blob": {
      "type": "object",
      "required": ["sha256", "bytes", "encoding"],
      "additionalProperties": false,
      "properties": {
        "sha256": {"$ref": "#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 0},
        "encoding": {"enum": ["utf-8", "utf-8-bom", "windows-31j"]}
      }
    },
    "parser_ir_blob": {
      "type": "object",
      "required": ["schema_id", "schema_hash", "sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "schema_id": {"type": "string", "format": "uri"},
        "schema_hash": {"$ref": "#/$defs/hash"},
        "sha256": {"$ref": "#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "logical_blob": {
      "type": "object",
      "required": ["profile", "sha256", "bytes", "media_type", "locator"],
      "additionalProperties": false,
      "properties": {
        "profile": {"const": "abc/raw-parser-diagnostics-schema-v3"},
        "sha256": {"$ref": "#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 0},
        "media_type": {"const": "application/json"},
        "locator": {"type": "string", "minLength": 1}
      }
    }
  }
}
