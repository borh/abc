{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/adr-external-evidence.schema.json",
  "title": "ABC ADR External Authority Evidence",
  "version": "0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_url", "retrieved_at", "review_after", "summary", "input_profile", "inputs", "observations"],
  "properties": {
    "schema_version": {"const": "abc-adr-external-evidence-v1"},
    "source_url": {"type": "string", "format": "uri"},
    "retrieved_at": {"$ref": "#/$defs/date"},
    "review_after": {"$ref": "#/$defs/date"},
    "summary": {"$ref": "#/$defs/summary"},
    "input_profile": {"$ref": "#/$defs/inputProfile"},
    "inputs": {"$ref": "#/$defs/inputs"},
    "observations": {"$ref": "#/$defs/observations"}
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "safeValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "string"},
        {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
        {"type": "array", "items": {"$ref": "#/$defs/safeValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/safeValue"}}
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash"],
      "properties": {
        "path": {"$ref": "#/$defs/nonEmptyString"},
        "hash": {"$ref": "#/$defs/hash"}
      }
    },
    "inputProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "explicit"],
      "properties": {
        "kind": {"const": "external-authority-v1"},
        "explicit": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    },
    "inputs": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/hash"}
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {"$ref": "#/$defs/safeValue"},
        "details": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/safeValue"}
        }
      }
    },
    "observations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9-]*$"},
      "additionalProperties": {"$ref": "#/$defs/observation"}
    }
  }
}
