{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/soranoha/schemas/parser-rq-core-attempt-index.schema.json",
  "title": "Parser RQ core attempt record index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "qualification_identity_ref", "candidate_ref", "policy_hash", "expected_work_ids", "repetitions", "reduction", "attempts", "records"],
  "properties": {
    "schema_id": {"const": "https://w3id.org/soranoha/schemas/parser-rq-core-attempt-index.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "qualification_identity_ref": {"$ref": "#/$defs/hash"},
    "candidate_ref": {"$ref": "#/$defs/hash"},
    "policy_hash": {"$ref": "#/$defs/hash"},
    "expected_work_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "repetitions": {"const": 3},
    "reduction": {"const": "maximum"},
    "attempts": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/attempt"}},
    "records": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["work_id", "repetition", "record"], "properties": {"work_id": {"type": "string", "minLength": 1}, "repetition": {"type": "integer", "minimum": 1, "maximum": 3}, "record": {"$ref": "#/$defs/blob"}}}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "blob": {"type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "media_type", "locator"], "properties": {"sha256": {"$ref": "#/$defs/hash"}, "bytes": {"type": "integer", "minimum": 0}, "media_type": {"type": "string", "minLength": 1}, "locator": {"$ref": "#/$defs/locator"}}},
    "locator": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "pressure": {"type": "object", "additionalProperties": false, "required": ["some_avg10", "full_avg10"], "properties": {"some_avg10": {"type": "number", "minimum": 0}, "full_avg10": {"type": "number", "minimum": 0}}},
    "context": {"type": "object", "additionalProperties": false, "required": ["captured_at_utc", "load_average_1m", "memory_pressure", "competing_units"], "properties": {"captured_at_utc": {"type": "string", "format": "date-time"}, "load_average_1m": {"type": "number", "minimum": 0}, "memory_pressure": {"$ref": "#/$defs/pressure"}, "competing_units": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "attempt": {"type": "object", "additionalProperties": false, "required": ["repetition", "elapsed_record", "argv", "exit_status", "lock_retained", "before", "after"], "properties": {"repetition": {"type": "integer", "minimum": 1, "maximum": 3}, "elapsed_record": {"$ref": "#/$defs/blob"}, "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "exit_status": {"type": "integer"}, "lock_retained": {"type": "boolean"}, "before": {"$ref": "#/$defs/context"}, "after": {"$ref": "#/$defs/context"}}}
  }
}
