<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0"
     xmlns:snh="https://w3id.org/soranoha/ns/tei"
     xmlns:rng="http://relaxng.org/ns/structure/1.0"
     xmlns:sch="http://purl.oclc.org/dsdl/schematron">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>Soranoha Aozora TEI Profile v0</title>
      </titleStmt>
      <editionStmt>
        <edition>Profile v0 with TEI P5 4.11.0 ruby support.</edition>
      </editionStmt>
      <publicationStmt>
        <p>TEI publication profile maintained by Soranoha.</p>
      </publicationStmt>
      <sourceDesc>
        <p>Customization of TEI P5 for Aozora Bunko source markup.</p>
      </sourceDesc>
    </fileDesc>
  </teiHeader>
  <text>
    <body>
      <schemaSpec ident="snh-tei-v0" start="TEI">
        <desc>Soranoha TEI profile for Aozora Bunko-derived artifacts.</desc>

        <!-- TEI modules -->
        <moduleRef key="tei"/>
        <moduleRef key="header"/>
        <moduleRef key="core"/>
        <moduleRef key="textstructure"/>
        <moduleRef key="namesdates"/>
        <moduleRef key="transcr"/>
        <moduleRef key="figures"/>
        <moduleRef key="gaiji"/>
        <moduleRef key="analysis"/>
        <moduleRef key="textcrit" include="app lem rdg"/>
        <moduleRef key="linking" include="seg anchor standOff"/>

        <elementSpec ident="figDesc" mode="change" module="figures">
          <content>
            <alternate minOccurs="0" maxOccurs="unbounded">
              <textNode/>
              <classRef key="model.limitedPhrase"/>
              <classRef key="model.inter"/>
              <elementRef key="anchor"/>
            </alternate>
          </content>
          <remarks>
            <p>Figure descriptions participate in the body text view. Anchors
            locate analysis ranges within that text without asserting a new
            transcription rendition.</p>
          </remarks>
        </elementSpec>

        <!-- Schematron constraint declarations -->
        <constraintDecl scheme="schematron" queryBinding="xslt2">
          <sch:ns prefix="snh" uri="https://w3id.org/soranoha/ns/tei"/>
        </constraintDecl>

        <!-- Project documentation -->
        <remarks>
          <p>
            This ODD defines the publication profile. Relax NG and Schematron
            schemas are generated from it for runtime validation.
          </p>
          <p>
            `tei_profile_hash` identifies this ODD/profile contract. Generated
            RNG and Schematron files are derived validation artifacts; generator
            version and stylesheet/toolchain hashes are validation-run metadata.
          </p>
          <p>
            Aozora ruby must preserve base text, reading, source span, and
            whether the base scope was explicit, inferred, grouped, mid-word, or
            ambiguous in the parser IR. Generated TEI uses `ruby @type =
            "furigana"` as the default Aozora publication heuristic, matching
            the TEI-EAJ jpn_classical convention. Parser IR retains the source
            classification independently of that rendering default. Aozora gaiji output must preserve the
            original marker and link to the resolution policy used to choose
            Unicode, IVS, glyph, or unresolved fallback output.
          </p>
          <p>
            Soranoha profile extensions use the namespace
            `https://w3id.org/soranoha/ns/tei` and require
            `snh:vocab-version` on generated TEI roots that carry Soranoha
            extension attributes; the current vocabulary is `1`. The v1
            extension is attributes-only. It
            permits derived audit projections such as `snh:preservation-record`,
            `snh:accent-code`, `snh:style-source`, `snh:layout-kind`,
            `snh:layout-params`, and `snh:figure-class` on ordinary TEI
            elements. These attributes project parser-IR evidence; they do not
            replace the source records from which they were derived.
          </p>
          <p>
            The namespace IRI identifies the extension and never changes. The
            vocabulary's major version is not implied by that IRI, which is why
            `snh:vocab-version` carries it separately: a breaking vocabulary
            change increments it, while an additive non-breaking attribute may
            keep the same major version when compatibility is documented.
          </p>
          <p>
            The profile hashes answer a different question. `odd_hash`,
            `rng_hash` and `schematron_hash` in the validation report change on
            any profile edit, additive ones included, so they record which
            profile validated a document but cannot tell a consumer whether an
            existing `snh:*` reader is still correct. That is what the
            vocabulary version is for, and it is why the two are not
            interchangeable.
          </p>
          <p>
            Permitted versions are declared once, as the values of the
            `snh:vocab-version` attribute below, and the generated Relax NG
            enforces them. The Schematron rule therefore checks only that the
            attribute is present when extension attributes are used. Admitting
            a new vocabulary version is a single addition to that value list,
            and published documents stay valid because the list grows rather
            than being replaced. The list starts at `1`: the vocabulary is
            first published at genesis, and a version numbered `0` in
            permanent, signed bytes would say the opposite.
          </p>
        </remarks>

        <list>
          <head>Schematron rule inventory</head>
          <item><label>snh-tei-header-title</label> error: every generated TEI file must have a main title in `teiHeader`, meaning a `title` that is not one of the subordinate forms (`sub`, `sub-reading`, `reading`, `original`), so that a file carrying only a subtitle or only a reading does not satisfy the rule.</item>
          <item><label>snh-tei-header-source-work-id</label> error: TEI header must preserve the Aozora work ID or source identifier.</item>
          <item><label>snh-publication-licence</label> error: teiHeader/fileDesc/publicationStmt/availability must carry a rights grant in a `licence` with a non-empty `@target`, so that a detached file states its own terms.</item>
          <item><label>snh-header-language-declared</label> error: teiHeader must declare at least one tei:profileDesc/tei:langUsage/tei:language with a non-empty @ident, so downstream tooling can route on document language.</item>
          <item><label>snh-ruby-complete</label> error: ruby structures must contain base and reading components.</item>
          <item><label>snh-ruby-base-non-empty</label> error: ruby base components must contain text or a declared character; empty `rb` defeats `snh-ruby-complete`.</item>
          <item><label>snh-ruby-reading-non-empty</label> error: ruby reading components must not be empty (closes the &lt;rb&gt;猫&lt;/rb&gt;&lt;rt&gt;&lt;/rt&gt; loophole that snh-ruby-complete leaves open).</item>
          <item><label>snh-gaiji-reference</label> error: gaiji must retain original marker and either a resolved replacement or unresolved status.</item>
          <item><label>snh-gaiji-chardecl-resolution</label> error: gaiji `@ref` fragment identifiers must point to a `charDecl/char` declaration in this document.</item>
          <item><label>snh-char-resolution-form</label> error: tei:charDecl/tei:char must declare at least one of tei:mapping, tei:unicodeProp, tei:localProp, or tei:desc (closes the &lt;char xml:id="x"/&gt; empty-declaration loophole).</item>
          <item><label>snh-figure-accessibility</label> warning: figures/images should preserve nonempty supplied descriptions or caption references where available.</item>
          <item><label>snh-source-span-reference</label> error: elements claiming source spans must point to valid span identifiers.</item>
          <item><label>snh-source-span-target-exists</label> error: each fragment id in `@source` must resolve to an `@xml:id` defined in this document.</item>
          <item><label>snh-transcription-vs-annotation</label> warning: linguistic enrichment must not be mixed into transcription unless declared.</item>
          <item><label>snh-vocab-version-declared</label> error: TEI roots using Soranoha extension attributes must declare `snh:vocab-version`; the permitted values are those declared for the attribute in this profile.</item>
          <item><label>snh-preservation-record-shape</label> error: `snh:preservation-record` values must be deterministic sidecar record ids of the form `r000000`.</item>
          <item><label>snh-layout-params-shape</label> error: `snh:layout-params` values must use the key=value grammar checked by this profile.</item>
        </list>

        <!-- Element/attribute constraints and documentation anchors -->
        <elementSpec ident="ruby" mode="change" module="core">
          <remarks>
            <p>Ruby is represented with native TEI `ruby`, `rb`, and `rt` elements. Generated Aozora ruby carries `@type="furigana"` by default, with optional `@rend` preserving parser IR ruby direction.</p>
          </remarks>
        </elementSpec>
        <elementSpec ident="g" mode="change" module="gaiji">
          <remarks>
            <p>Gaiji uses TEI `g` with a stable declaration or resolution reference.</p>
          </remarks>
        </elementSpec>
        <elementSpec ident="char" mode="change" module="gaiji">
          <remarks>
            <p>Character declarations document unresolved or custom external-character mappings.</p>
          </remarks>
        </elementSpec>
        <classSpec ident="att.global" mode="change" module="tei" type="atts">
          <attList>
            <attDef ident="vocab-version" mode="add" ns="https://w3id.org/soranoha/ns/tei" usage="opt">
              <desc>Soranoha TEI namespace vocabulary major version. This value list declares the permitted versions; add to it rather than replacing it.</desc>
              <valList type="closed">
                <valItem ident="1"/>
              </valList>
            </attDef>
            <attDef ident="preservation-record" mode="add" ns="https://w3id.org/soranoha/ns/tei" usage="opt">
              <desc>Deterministic publication-preservation sidecar record id.</desc>
              <datatype>
                <rng:data type="string">
                  <rng:param name="pattern">r[0-9]{6}</rng:param>
                </rng:data>
              </datatype>
            </attDef>
            <attDef ident="ir-pointer" mode="add" ns="https://w3id.org/soranoha/ns/tei" usage="opt">
              <desc>Parser-IR pointer for the projected publication fact.</desc>
              <datatype>
                <rng:data type="string"/>
              </datatype>
            </attDef>
            <attDef ident="source-pointer" mode="add" ns="https://w3id.org/soranoha/ns/tei" usage="opt">
              <desc>Source or AAT pointer for the projected publication fact.</desc>
              <datatype>
                <rng:data type="string"/>
              </datatype>
            </attDef>
            <attDef ident="source-marker" mode="add" ns="https://w3id.org/soranoha/ns/tei" usage="opt">
              <desc>Original Aozora source marker when a TEI-native rendering is normalized.</desc>
              <datatype>
                <rng:data type="string"/>
              </datatype>
            </attDef>
            <attDef ident="accent-code" mode="add" ns="https://w3id.org/soranoha/ns/tei" usage="opt">
              <desc>Aozora accent notation code projected into TEI.</desc>
              <datatype>
                <rng:data type="string"/>
              </datatype>
            </attDef>
            <attDef ident="style-source" mode="add" ns="https://w3id.org/soranoha/ns/tei" usage="opt">
              <desc>Aozora style source marker projected into TEI.</desc>
              <datatype>
                <rng:data type="string"/>
              </datatype>
            </attDef>
            <attDef ident="layout-kind" mode="add" ns="https://w3id.org/soranoha/ns/tei" usage="opt">
              <desc>Closed Soranoha layout kind projected from parser-IR layout facts.</desc>
              <datatype>
                <rng:data type="string"/>
              </datatype>
            </attDef>
            <attDef ident="layout-params" mode="add" ns="https://w3id.org/soranoha/ns/tei" usage="opt">
              <desc>Semicolon-delimited key=value layout parameters.</desc>
              <datatype>
                <rng:data type="string"/>
              </datatype>
            </attDef>
            <attDef ident="figure-class" mode="add" ns="https://w3id.org/soranoha/ns/tei" usage="opt">
              <desc>Aozora figure class projected into TEI figure output.</desc>
              <datatype>
                <rng:data type="string"/>
              </datatype>
            </attDef>
          </attList>
        </classSpec>

        <!-- Schematron constraint declarations -->
        <constraintSpec ident="snh-tei-header-title" scheme="schematron">
          <desc>Require a main title in generated Soranoha TEI headers.</desc>
          <constraint>
            <sch:rule context="tei:teiHeader">
              <sch:assert test="tei:fileDesc/tei:titleStmt/tei:title[not(@type = ('sub', 'sub-reading', 'reading', 'original'))]">
                Soranoha TEI requires a main title in teiHeader/fileDesc/titleStmt.
              </sch:assert>
            </sch:rule>
          </constraint>
        </constraintSpec>

        <constraintSpec ident="snh-tei-header-source-work-id" scheme="schematron">
          <desc>Require an Aozora work ID or source identifier in generated headers.</desc>
          <constraint>
            <sch:rule context="tei:teiHeader">
              <sch:assert test=".//tei:idno[@type = ('aozora-work-id', 'source-work-id')]">
                Soranoha TEI requires an Aozora work ID or source work identifier.
              </sch:assert>
            </sch:rule>
          </constraint>
        </constraintSpec>

        <constraintSpec ident="snh-publication-licence" scheme="schematron">
          <desc>Require the published rights grant in generated Soranoha TEI headers.</desc>
          <constraint>
            <sch:rule context="tei:teiHeader">
              <sch:assert test="tei:fileDesc/tei:publicationStmt/tei:availability/tei:licence[@target and normalize-space(@target) != '']">
                Soranoha TEI requires a rights grant in teiHeader/fileDesc/publicationStmt/availability/licence with a non-empty @target (snh-publication-licence)
              </sch:assert>
            </sch:rule>
          </constraint>
        </constraintSpec>

        <constraintSpec ident="snh-header-language-declared" scheme="schematron">
          <desc>Require a declared document language in generated headers.</desc>
          <constraint>
            <sch:rule context="tei:TEI">
              <sch:assert test="tei:teiHeader/tei:profileDesc/tei:langUsage/tei:language[@ident and normalize-space(@ident) != '']">
                teiHeader must declare at least one tei:profileDesc/tei:langUsage/tei:language with non-empty @ident (snh-header-language-declared)
              </sch:assert>
            </sch:rule>
          </constraint>
        </constraintSpec>

        <constraintSpec ident="snh-ruby-complete" scheme="schematron">
          <desc>Require ruby base and reading components.</desc>
          <constraint>
            <sch:rule context="tei:ruby">
              <sch:assert test="tei:rb and tei:rt">
                Soranoha TEI ruby requires both rb and rt components.
              </sch:assert>
            </sch:rule>
          </constraint>
        </constraintSpec>

        <constraintSpec ident="snh-ruby-base-non-empty" scheme="schematron">
          <desc>Require ruby bases to carry source text or declared characters.</desc>
          <constraint>
            <sch:rule context="tei:ruby/tei:rb">
              <sch:assert test="normalize-space(string(.)) != '' or .//tei:g[starts-with(@ref, '#')]">
                Soranoha TEI ruby base must contain source text or a declared character.
              </sch:assert>
            </sch:rule>
          </constraint>
        </constraintSpec>

        <constraintSpec ident="snh-ruby-reading-non-empty" scheme="schematron">
          <desc>Require ruby readings to carry source text or declared characters.</desc>
          <constraint>
            <sch:rule context="tei:ruby/tei:rt">
              <sch:assert test="normalize-space(string(.)) != '' or .//tei:g[starts-with(@ref, '#')]">
                Soranoha TEI ruby reading must contain source text or a declared character.
              </sch:assert>
            </sch:rule>
          </constraint>
        </constraintSpec>

        <constraintSpec ident="snh-gaiji-reference" scheme="schematron">
          <desc>Require gaiji traceability and resolution status.</desc>
          <constraint>
            <sch:rule context="tei:g">
              <sch:assert test="@ref or @corresp or @ana">
                Soranoha TEI gaiji requires a declaration reference, source marker reference, or resolution status.
              </sch:assert>
            </sch:rule>
          </constraint>
        </constraintSpec>

        <constraintSpec ident="snh-gaiji-chardecl-resolution" scheme="schematron">
          <desc>Require local gaiji `@ref` to resolve to a `charDecl/char` declaration in this document.</desc>
          <constraint>
            <sch:rule context="tei:g[starts-with(@ref, '#')]">
              <sch:assert test="/tei:TEI/tei:teiHeader//tei:charDecl/tei:char/@xml:id = substring-after(@ref, '#')">
                Soranoha TEI gaiji local @ref must point to a charDecl/char declaration in this document.
              </sch:assert>
            </sch:rule>
          </constraint>
        </constraintSpec>

        <constraintSpec ident="snh-char-resolution-form" scheme="schematron">
          <desc>Require character declarations to carry at least one non-empty resolution form.</desc>
          <constraint>
            <sch:rule context="tei:charDecl/tei:char">
              <sch:assert test="(some $m in tei:mapping satisfies normalize-space(string($m)) != '') or (some $u in tei:unicodeProp satisfies normalize-space(string($u/@value)) != '') or (some $l in tei:localProp satisfies normalize-space(string($l/@value)) != '') or (some $d in tei:desc satisfies normalize-space(string($d)) != '')">
                tei:charDecl/tei:char must declare at least one non-empty resolution form: tei:mapping, tei:unicodeProp/@value, tei:localProp/@value, or tei:desc (snh-char-resolution-form)
              </sch:assert>
            </sch:rule>
          </constraint>
        </constraintSpec>

        <constraintSpec ident="snh-figure-accessibility" scheme="schematron">
          <desc>Warn when a figure has no textual description.</desc>
          <constraint>
            <sch:rule context="tei:figure">
              <sch:report role="warning" test="not((tei:figDesc | tei:head | tei:p | tei:note[@type = ('image-description', 'caption-reference')])[normalize-space(.) != ''])">
                Soranoha TEI figure should preserve a nonempty source description or caption reference when available.
              </sch:report>
            </sch:rule>
          </constraint>
        </constraintSpec>

        <constraintSpec ident="snh-source-span-reference" scheme="schematron">
          <desc>Require source-span references to be local fragment identifiers.</desc>
          <constraint>
            <sch:rule context="*[@source]">
              <sch:assert test="every $s in tokenize(normalize-space(@source), '\s+') satisfies starts-with($s, '#')">
                Soranoha TEI source span references must point to local span identifiers.
              </sch:assert>
            </sch:rule>
          </constraint>
        </constraintSpec>

        <constraintSpec ident="snh-source-span-target-exists" scheme="schematron">
          <desc>Require each `@source` fragment id to resolve to an `@xml:id` in this document.</desc>
          <constraint>
            <sch:rule context="*[@source]">
              <sch:assert test="every $s in tokenize(normalize-space(@source), '\s+') satisfies exists(id(substring-after($s, '#'))[@xml:id = substring-after($s, '#')])">
                Soranoha TEI source span fragments must resolve to an existing @xml:id in this document.
              </sch:assert>
            </sch:rule>
          </constraint>
        </constraintSpec>

        <constraintSpec ident="snh-transcription-vs-annotation" scheme="schematron">
          <desc>Warn when linguistic enrichment appears in the transcription body without declaration. The context is every element the analysis module contributes, because the profile admits that module whole and any of its elements inside tei:text is an inline annotation. The supported enrichment path is unaffected: it inserts linking-module anchors into the body and keeps its spans in a standOff sibling of tei:text.</desc>
          <constraint>
            <sch:rule context="tei:text//tei:c | tei:text//tei:cl | tei:text//tei:interp | tei:text//tei:interpGrp | tei:text//tei:m | tei:text//tei:pc | tei:text//tei:phr | tei:text//tei:s | tei:text//tei:span | tei:text//tei:spanGrp | tei:text//tei:w">
              <sch:assert role="warning" test="ancestor::tei:TEI/tei:teiHeader//tei:encodingDesc//tei:tagsDecl//tei:namespace[@name = 'http://www.tei-c.org/ns/1.0']/tei:tagUsage/@gi = local-name()">
                Soranoha TEI linguistic enrichment in the transcription layer must be declared in the header.
              </sch:assert>
            </sch:rule>
          </constraint>
        </constraintSpec>

        <constraintSpec ident="snh-vocab-version-declared" scheme="schematron">
          <desc>Require generated TEI with Soranoha extension attributes to declare the Soranoha vocabulary version. The permitted values are declared once, for the attribute itself.</desc>
          <constraint>
            <sch:rule context="tei:TEI[@snh:* or .//@snh:*]">
              <sch:assert test="@snh:vocab-version">
                TEI roots using Soranoha extension attributes must declare snh:vocab-version.
              </sch:assert>
            </sch:rule>
          </constraint>
        </constraintSpec>

        <constraintSpec ident="snh-preservation-record-shape" scheme="schematron">
          <desc>Require preservation record references to use deterministic sidecar ids.</desc>
          <constraint>
            <sch:rule context="*[@snh:preservation-record]">
              <sch:assert test="matches(@snh:preservation-record, '^r[0-9]{6}$')">
                snh:preservation-record must be a deterministic preservation sidecar record id such as r000042.
              </sch:assert>
            </sch:rule>
          </constraint>
        </constraintSpec>

        <constraintSpec ident="snh-layout-params-shape" scheme="schematron">
          <desc>Require Soranoha layout params to use the declared key=value grammar.</desc>
          <constraint>
            <sch:rule context="*[@snh:layout-params]">
              <sch:assert test="matches(@snh:layout-params, '^[A-Za-z0-9_.:-]+=[^\s;]+(;[A-Za-z0-9_.:-]+=[^\s;]+)*$')">
                snh:layout-params must use semicolon-delimited key=value pairs.
              </sch:assert>
            </sch:rule>
          </constraint>
        </constraintSpec>
      </schemaSpec>
    </body>
  </text>
</TEI>
