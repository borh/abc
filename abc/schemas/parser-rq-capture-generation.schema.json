{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-capture-generation.schema.json",
  "type": "object",
  "required": ["schema_version", "generation_ref", "qualification_identity_ref", "work_id", "members"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "abc/parser-rq-capture-generation/v1"},
    "generation_ref": {"$ref": "#/$defs/hash"},
    "qualification_identity_ref": {"$ref": "#/$defs/hash"},
    "work_id": {"type": "string", "minLength": 1},
    "members": {"type": "object", "required": ["decoded_source", "parser_output", "raw_diagnostics", "classified_source_ledger"], "additionalProperties": false, "properties": {"decoded_source": {"$ref": "#/$defs/member"}, "parser_output": {"$ref": "#/$defs/member"}, "raw_diagnostics": {"$ref": "#/$defs/member"}, "classified_source_ledger": {"$ref": "#/$defs/member"}}}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "member": {"type": "object", "required": ["artifact_ref", "value_hash", "generation_ref"], "additionalProperties": false, "properties": {"artifact_ref": {"type": "string", "minLength": 1}, "value_hash": {"$ref": "#/$defs/hash"}, "generation_ref": {"$ref": "#/$defs/hash"}}}}
}
