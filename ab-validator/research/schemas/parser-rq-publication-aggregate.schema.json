{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/soranoha/schemas/parser-rq-publication-aggregate.schema.json",
  "title": "Parser RQ publication aggregate",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "status",
    "qualification_identity_ref",
    "policy_hash",
    "preservation_schema_hash",
    "validator_semantics_hash",
    "census_hash",
    "counts"
  ],
  "properties": {
    "schema_id": {
      "const": "https://w3id.org/soranoha/schemas/parser-rq-publication-aggregate.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "ok",
        "unavailable"
      ]
    },
    "qualification_identity_ref": {
      "$ref": "#/$defs/hash"
    },
    "policy_hash": {
      "$ref": "#/$defs/hash"
    },
    "preservation_schema_hash": {
      "$ref": "#/$defs/hash"
    },
    "validator_semantics_hash": {
      "$ref": "#/$defs/hash"
    },
    "census_hash": {
      "$ref": "#/$defs/hash"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "parsed", "failed", "timed_out", "eligible", "passed"],
      "properties": {
        "expected": {"type": "integer", "minimum": 0},
        "parsed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "timed_out": {"type": "integer", "minimum": 0},
        "eligible": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0}
      }
    },
    "ratio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "value"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1},
        "value": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "denominator_shrink_witnesses": {
      "type": "array",
      "items": {"$ref": "#/$defs/dispositionWitness"}
    },
    "failed_work_witnesses": {
      "type": "array",
      "items": {"$ref": "#/$defs/failureWitness"}
    }
  },
  "$defs": {
    "dispositionWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_id", "parser_disposition"],
      "properties": {
        "work_id": {"type": "string", "minLength": 1},
        "parser_disposition": {"enum": ["failed", "timeout"]}
      }
    },
    "failureWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_id", "failed_checks"],
      "properties": {
        "work_id": {"type": "string", "minLength": 1},
        "failed_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
