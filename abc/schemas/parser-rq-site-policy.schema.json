{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-site-policy.schema.json",
  "title": "Parser RQ committed site identity policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "policy_hash", "stable_host_label", "kernel_hostname", "production_graph_version", "primary_failure_domain", "replica_status", "remote_filesystem_allowlist"],
  "properties": {
    "schema_id": {"const": "https://w3id.org/abc/schemas/parser-rq-site-policy.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "policy_hash": {"$ref": "#/$defs/hash"},
    "stable_host_label": {"const": "hinoki.hyakutake-barbel.ts.net"},
    "kernel_hostname": {"const": "hinoki"},
    "production_graph_version": {"const": "abc/parser-rq-production-graph/v1"},
    "primary_failure_domain": {"type": "string", "minLength": 1, "pattern": "^[^/]+$"},
    "replica_status": {"enum": ["unconfigured", "configured"]},
    "remote_filesystem_allowlist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["nfs", "nfs4", "cifs", "ceph", "fuse.sshfs"]}},
    "replica_failure_domain": {"type": "string", "minLength": 1, "pattern": "^[^/]+$"},
    "replica_mount_class": {"enum": ["nfs", "nfs4", "cifs", "ceph", "fuse.sshfs"]},
    "replica_authority": {"type": "string", "minLength": 1, "pattern": "^[^/]+$"}
  },
  "allOf": [{
    "if": {"properties": {"replica_status": {"const": "configured"}}, "required": ["replica_status"]},
    "then": {"required": ["replica_failure_domain", "replica_mount_class", "replica_authority"]},
    "else": {"not": {"anyOf": [{"required": ["replica_failure_domain"]}, {"required": ["replica_mount_class"]}, {"required": ["replica_authority"]}]}}
  }],
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
