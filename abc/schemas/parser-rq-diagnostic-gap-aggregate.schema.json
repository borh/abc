{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-diagnostic-gap-aggregate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "qualification_identity_ref", "corpus_generation_ref", "policy_hash", "expected_work_ids", "observed_work_ids", "authorized_bytes", "silent_bytes", "silent_drop_count", "diagnostic_count", "authorizing_diagnostic_count", "observe_only_diagnostic_count", "authorized_interval_count", "vacuous"],
  "properties": {
    "status": {"const": "ok"},
    "qualification_identity_ref": {"$ref": "#/$defs/hash"},
    "corpus_generation_ref": {"$ref": "#/$defs/hash"},
    "policy_hash": {"$ref": "#/$defs/hash"},
    "expected_work_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "observed_work_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authorized_bytes": {"$ref": "#/$defs/count"},
    "silent_bytes": {"$ref": "#/$defs/count"},
    "silent_drop_count": {"$ref": "#/$defs/count"},
    "diagnostic_count": {"$ref": "#/$defs/count"},
    "authorizing_diagnostic_count": {"$ref": "#/$defs/count"},
    "observe_only_diagnostic_count": {"$ref": "#/$defs/count"},
    "authorized_interval_count": {"$ref": "#/$defs/count"},
    "vacuous": {"type": "boolean"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  }
}
