{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:snh:schema:governance-event:1",
  "title": "snh-governance-event/1",
  "description": "Governance event structure. Kind-conditional shape: in a withdrawal no entry has `amends`; in an event-amendment every entry has `amends`. Entry ordering (sorted by slug) and slug uniqueness are semantic rules checked by the verifier. No dedicated date or timestamp field exists; substantive dates may appear inside the free-form statement text.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "entries"],
      "properties": {
        "schema": { "const": "snh-governance-event/1" },
        "kind": { "const": "withdrawal" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slug", "reason_code", "statement"],
            "properties": {
              "slug": { "$ref": "#/$defs/slug" },
              "reason_code": { "$ref": "#/$defs/reason-code" },
              "statement": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "entries"],
      "properties": {
        "schema": { "const": "snh-governance-event/1" },
        "kind": { "const": "event-amendment" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slug", "reason_code", "statement", "amends"],
            "properties": {
              "slug": { "$ref": "#/$defs/slug" },
              "reason_code": { "$ref": "#/$defs/reason-code" },
              "statement": { "type": "string" },
              "amends": {
                "type": "string",
                "pattern": "^snh:1:governance-event:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "slug": { "type": "string", "pattern": "^[0-9a-z_-]+$" },
    "reason-code": {
      "enum": ["rights", "takedown-request", "data-defect", "other"]
    }
  }
}
