{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soranoha.example/schemas/parser-comparison-study.schema.json",
  "title": "Soranoha parser comparison preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "frozen_at", "research_questions", "candidate_rules", "candidates", "corpora", "fixture_manifests", "measurement_modes", "outcome_rules", "axes", "performance_protocol", "analysis", "baseline_verification"],
  "properties": {
    "schema_version": {"const": 1},
    "study_id": {"type": "string", "minLength": 1},
    "frozen_at": {"type": "string", "format": "date-time"},
    "research_questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}},
    "candidate_rules": {"$ref": "#/$defs/candidateRules"},
    "candidates": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "prefixItems": [{"$ref": "#/$defs/candidateAozora"}, {"$ref": "#/$defs/candidateAozora2"}, {"$ref": "#/$defs/candidateAozoraRs"}, {"$ref": "#/$defs/candidateAozora2html"}, {"$ref": "#/$defs/candidateAozoraEpub3"}, {"$ref": "#/$defs/candidateAozoraParserJs"}, {"$ref": "#/$defs/candidateAbAozora"}], "items": false},
    "corpora": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/corpus"}},
    "fixture_manifests": {"$ref": "#/$defs/fixtureManifests"},
    "measurement_modes": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"const": "native"}, {"const": "adapter_normalized"}], "items": false, "uniqueItems": true},
    "outcome_rules": {"$ref": "#/$defs/outcomeRules"},
    "axes": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "prefixItems": [{"$ref": "#/$defs/axisConstruct"}, {"$ref": "#/$defs/axisFidelity"}, {"$ref": "#/$defs/axisRobustness"}, {"$ref": "#/$defs/axisDiagnostics"}, {"$ref": "#/$defs/axisSpans"}, {"$ref": "#/$defs/axisPerformance"}, {"$ref": "#/$defs/axisMaintenance"}, {"$ref": "#/$defs/axisPackaging"}, {"$ref": "#/$defs/axisLicense"}], "items": false},
    "performance_protocol": {"$ref": "#/$defs/performanceProtocol"},
    "analysis": {"$ref": "#/$defs/analysis"},
    "baseline_verification": {"$ref": "#/$defs/baseline"}
  },
  "$defs": {
    "question": {"type": "object", "additionalProperties": false, "required": ["id", "question", "intended_use"], "properties": {"id": {"type": "string"}, "question": {"type": "string"}, "intended_use": {"type": "string"}}},
    "candidateRules": {"type": "object", "additionalProperties": false, "required": ["include", "exclude"], "properties": {"include": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "exclude": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["id", "role", "disposition", "revision", "adapter_revision", "reason"], "properties": {"id": {"type": "string"}, "role": {"enum": ["existing_parser", "custom_baseline"]}, "disposition": {"enum": ["included", "excluded", "shared_instrument_appendix"]}, "revision": {"type": "string", "minLength": 1}, "adapter_revision": {"type": ["string", "null"]}, "reason": {"type": "string", "minLength": 1}}},
    "candidateAozora": {"allOf": [{"$ref": "#/$defs/candidate"}, {"properties": {"id": {"const": "aozora"}}}]},
    "candidateAozora2": {"allOf": [{"$ref": "#/$defs/candidate"}, {"properties": {"id": {"const": "aozora2"}}}]},
    "candidateAozoraRs": {"allOf": [{"$ref": "#/$defs/candidate"}, {"properties": {"id": {"const": "aozora-rs"}}}]},
    "candidateAozora2html": {"allOf": [{"$ref": "#/$defs/candidate"}, {"properties": {"id": {"const": "aozora2html"}}}]},
    "candidateAozoraEpub3": {"allOf": [{"$ref": "#/$defs/candidate"}, {"properties": {"id": {"const": "aozora-epub3"}}}]},
    "candidateAozoraParserJs": {"allOf": [{"$ref": "#/$defs/candidate"}, {"properties": {"id": {"const": "aozora-parser.js"}}}]},
    "candidateAbAozora": {"allOf": [{"$ref": "#/$defs/candidate"}, {"properties": {"id": {"const": "ab-aozora"}}}]},
    "corpus": {"type": "object", "additionalProperties": false, "required": ["id", "revision", "selection", "unit", "denominator"], "properties": {"id": {"type": "string"}, "revision": {"type": "string"}, "selection": {"type": "string"}, "unit": {"type": "string"}, "denominator": {"type": "string"}}},
    "outcomeRules": {"type": "object", "additionalProperties": false, "required": ["failure", "timeout", "unsupported", "silent_drop", "uncertainty", "missing_data"], "properties": {"failure": {"type": "string"}, "timeout": {"type": "string"}, "unsupported": {"type": "string"}, "silent_drop": {"type": "string"}, "uncertainty": {"type": "string"}, "missing_data": {"type": "string"}}},
    "axis": {"type": "object", "additionalProperties": false, "required": ["id", "outputs", "denominator"], "properties": {"id": {"enum": ["construct_coverage", "fidelity", "robustness", "diagnostics", "spans", "performance", "maintenance", "packaging", "license"]}, "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "denominator": {"type": "string", "minLength": 1}}},
    "axisConstruct": {"allOf": [{"$ref": "#/$defs/axis"}, {"properties": {"id": {"const": "construct_coverage"}}}]},
    "axisFidelity": {"allOf": [{"$ref": "#/$defs/axis"}, {"properties": {"id": {"const": "fidelity"}}}]},
    "axisRobustness": {"allOf": [{"$ref": "#/$defs/axis"}, {"properties": {"id": {"const": "robustness"}}}]},
    "axisDiagnostics": {"allOf": [{"$ref": "#/$defs/axis"}, {"properties": {"id": {"const": "diagnostics"}}}]},
    "axisSpans": {"allOf": [{"$ref": "#/$defs/axis"}, {"properties": {"id": {"const": "spans"}}}]},
    "axisPerformance": {"allOf": [{"$ref": "#/$defs/axis"}, {"properties": {"id": {"const": "performance"}}}]},
    "axisMaintenance": {"allOf": [{"$ref": "#/$defs/axis"}, {"properties": {"id": {"const": "maintenance"}}}]},
    "axisPackaging": {"allOf": [{"$ref": "#/$defs/axis"}, {"properties": {"id": {"const": "packaging"}}}]},
    "axisLicense": {"allOf": [{"$ref": "#/$defs/axis"}, {"properties": {"id": {"const": "license"}}}]},
    "fixtureRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "inclusion"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"pattern": "^sha256:[0-9a-f]{64}$"}, "inclusion": {"type": "string", "minLength": 1}}},
    "fixtureManifests": {"type": "object", "additionalProperties": false, "required": ["robustness", "diagnostics"], "properties": {"robustness": {"$ref": "#/$defs/fixtureRef"}, "diagnostics": {"$ref": "#/$defs/fixtureRef"}}},
    "performanceProtocol": {"type": "object", "additionalProperties": false, "required": ["workset_id", "workset_sha256", "warmup_repetitions", "measured_repetitions", "candidate_order", "work_order", "concurrency", "environment", "timeout_seconds", "timeout_treatment"], "properties": {"workset_id": {"const": "performance-largest-six-v1"}, "workset_sha256": {"pattern": "^sha256:[0-9a-f]{64}$"}, "warmup_repetitions": {"type": "integer", "minimum": 0}, "measured_repetitions": {"type": "integer", "minimum": 1}, "candidate_order": {"type": "array", "minItems": 5, "maxItems": 5, "prefixItems": [{"const": "aozora"}, {"const": "aozora2"}, {"const": "aozora-rs"}, {"const": "aozora2html"}, {"const": "aozora-epub3"}], "items": false}, "work_order": {"const": "manifest_order"}, "concurrency": {"const": 1}, "environment": {"type": "string", "minLength": 1}, "timeout_seconds": {"type": "integer", "minimum": 1}, "timeout_treatment": {"const": "right_censored_at_300_seconds_and_counted_as_timeout_failure"}}},
    "analysis": {"type": "object", "additionalProperties": false, "required": ["unqualified_aggregate_score", "reporting_order", "use_case_weighting"], "properties": {"unqualified_aggregate_score": {"const": "prohibited"}, "reporting_order": {"type": "string"}, "use_case_weighting": {"type": "object", "additionalProperties": false, "required": ["named_use_case_required", "sensitivity_analysis_required", "procedure"], "properties": {"named_use_case_required": {"const": true}, "sensitivity_analysis_required": {"const": true}, "procedure": {"type": "string"}}}}},
    "baseline": {"type": "object", "additionalProperties": false, "required": ["integrated_commit", "integration_ancestor_of", "custom_parser_revision", "verification_repairs", "checks"], "properties": {"integrated_commit": {"pattern": "^[0-9a-f]{40}$"}, "integration_ancestor_of": {"pattern": "^[0-9a-f]{40}$"}, "custom_parser_revision": {"pattern": "^[0-9a-f]{40}$"}, "verification_repairs": {"type": "array", "items": {"pattern": "^[0-9a-f]{40}$"}}, "checks": {"type": "array", "minItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["command", "result", "observed_at"], "properties": {"command": {"type": "string"}, "result": {"enum": ["pass", "fail"]}, "observed_at": {"type": "string", "format": "date-time"}}}}}}
  }
}
