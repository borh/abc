{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-ir.schema.json",
  "title": "ABC Parser IR",
  "type": "object",
  "required": ["schema_id", "schema_hash", "source", "nodes", "warnings", "errors"],
  "additionalProperties": false,
  "properties": {
    "schema_id": { "type": "string" },
    "schema_hash": { "$ref": "#/$defs/hash" },
    "derived_from": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "aat_version",
        "aat_adapter",
        "mapping_id",
        "mapping_version",
        "mapping_schema_hash"
      ],
      "properties": {
        "aat_version": { "type": "integer", "minimum": 1 },
        "aat_adapter": { "type": "string" },
        "aat_adapter_version": { "type": ["string", "null"] },
        "mapping_id": { "type": "string", "format": "uri" },
        "mapping_version": { "type": "string" },
        "mapping_schema_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "source": {
      "type": "object",
      "required": ["work_content_hash", "encoding", "normalization"],
      "additionalProperties": false,
      "properties": {
        "work_content_hash": { "$ref": "#/$defs/hash" },
        "source_path": { "type": ["string", "null"] },
        "encoding": { "type": "string", "enum": ["Shift_JIS", "UTF-8", "EUC-JP", "unknown"] },
        "normalization": { "type": "string", "enum": ["source", "NFC", "NFKC"] }
      }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "paragraphs": {
      "type": "array",
      "items": { "$ref": "#/$defs/paragraph" },
      "default": []
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "span": {
      "type": "object",
      "$comment": "Coordinate system is decoded_utf8: start/end are UTF-8 byte offsets into the decoded source string; line is 1-based; column is nullable. All fields except start/end are optional for backwards compatibility. end must be greater than or equal to start; JSON Schema cannot compare sibling numeric values portably without a non-standard extension.",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "minimum": 0, "description": "UTF-8 byte offset into the decoded source string where the span begins." },
        "end": { "type": "integer", "minimum": 0, "description": "UTF-8 byte offset into the decoded source string where the span ends." },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "column": { "type": ["integer", "null"], "minimum": 1 },
        "coordinate_system": { "type": "string", "const": "decoded_utf8", "default": "decoded_utf8", "description": "When present, declares that start/end are UTF-8 byte offsets into the decoded source string." }
      }
    },
    "baseNode": {
      "type": "object",
      "required": ["type", "span"],
      "properties": {
        "type": { "type": "string" },
        "span": { "$ref": "#/$defs/span" }
      }
    },
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/textNode" },
        { "$ref": "#/$defs/rubyNode" },
        { "$ref": "#/$defs/gaijiNode" },
        { "$ref": "#/$defs/editorNoteNode" },
        { "$ref": "#/$defs/emphasisNode" },
        { "$ref": "#/$defs/layoutSpanNode" },
        { "$ref": "#/$defs/headingNode" },
        { "$ref": "#/$defs/indentationNode" },
        { "$ref": "#/$defs/pageBreakNode" },
        { "$ref": "#/$defs/lineBreakNode" },
        { "$ref": "#/$defs/imageNode" },
        { "$ref": "#/$defs/captionNode" },
        { "$ref": "#/$defs/quoteNode" },
        { "$ref": "#/$defs/sourceNoteNode" }
      ]
    },
    "inlineNode": {
      "oneOf": [
        { "$ref": "#/$defs/textNode" },
        { "$ref": "#/$defs/rubyNode" },
        { "$ref": "#/$defs/gaijiNode" },
        { "$ref": "#/$defs/editorNoteNode" },
        { "$ref": "#/$defs/emphasisNode" },
        { "$ref": "#/$defs/layoutSpanNode" },
        { "$ref": "#/$defs/lineBreakNode" }
      ]
    },
    "nodeRange": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "paragraphLayout": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "source", "indent"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "jisage" },
            "source": { "$ref": "#/$defs/paragraphLayoutSource" },
            "indent": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "source", "first_line_indent", "continuation_indent"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "burasage" },
            "source": { "$ref": "#/$defs/paragraphLayoutSource" },
            "first_line_indent": { "type": "integer", "minimum": 0 },
            "continuation_indent": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "source", "align", "offset_from_end"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "chitsuki" },
            "source": { "$ref": "#/$defs/paragraphLayoutSource" },
            "align": { "type": "string", "enum": ["right"] },
            "offset_from_end": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "source", "width"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "jizume" },
            "source": { "$ref": "#/$defs/paragraphLayoutSource" },
            "width": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "source", "indent"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "line-jisage" },
            "source": { "$ref": "#/$defs/paragraphLayoutSource" },
            "indent": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "paragraphLayoutSource": {
      "type": "string",
      "enum": ["aat-block", "aat-style", "source-derived", "heuristic"]
    },
    "layoutScopeSource": {
      "type": "string",
      "enum": ["aat-inline", "aat-block", "source-derived", "heuristic"]
    },
    "layoutScope": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "source", "size_type", "level"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "font-size" },
            "source": { "$ref": "#/$defs/layoutScopeSource" },
            "size_type": { "type": "string" },
            "level": { "type": "integer", "minimum": 0 },
            "marker": { "type": ["string", "null"] }
          }
        },
        {
          "type": "object",
          "required": ["kind", "source"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "tcy" },
            "source": { "$ref": "#/$defs/layoutScopeSource" },
            "marker": { "type": ["string", "null"] }
          }
        },
        {
          "type": "object",
          "required": ["kind", "source"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "keigakomi" },
            "source": { "$ref": "#/$defs/layoutScopeSource" },
            "border": { "type": ["string", "null"] },
            "marker": { "type": ["string", "null"] }
          }
        },
        {
          "type": "object",
          "required": ["kind", "source", "direction"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "yokogumi" },
            "source": { "$ref": "#/$defs/layoutScopeSource" },
            "direction": { "type": "string", "enum": ["horizontal"] },
            "marker": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "paragraph": {
      "type": "object",
      "required": ["id", "span", "span_source", "node_range", "role", "source_pointer", "classification"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^p[0-9]{6}$" },
        "span": { "$ref": "#/$defs/span" },
        "span_source": { "type": "string", "enum": ["direct", "derived", "synthesized", "unknown"] },
        "node_range": { "$ref": "#/$defs/nodeRange" },
        "role": { "type": "string", "enum": ["body", "source-note", "unknown"] },
        "source_pointer": { "type": ["string", "null"] },
        "classification": { "type": "string", "enum": ["direct", "heuristic", "unknown"] },
        "layout": { "$ref": "#/$defs/paragraphLayout" }
      }
    },
    "textNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "text"],
          "properties": {
            "type": { "const": "text" },
            "span": { "$ref": "#/$defs/span" },
            "text": { "type": "string" }
          }
        }
      ]
    },
    "rubyNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "ruby"],
          "properties": {
            "type": { "const": "ruby" },
            "span": { "$ref": "#/$defs/span" },
            "ruby": {
              "type": "object",
              "additionalProperties": false,
              "required": ["base", "reading", "scope"],
              "properties": {
                "base": { "type": "string" },
                "reading": { "type": "string" },
                "scope": { "type": "string", "enum": ["explicit", "inferred", "group", "mid-word", "ambiguous"] },
                "direction": { "type": ["string", "null"], "enum": ["left", "right", null], "description": "Ruby reading placement relative to base text: left (before base) or right (after base)." }
              }
            }
          }
        }
      ]
    },
    "gaijiNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "gaiji"],
          "properties": {
            "type": { "const": "gaiji" },
            "span": { "$ref": "#/$defs/span" },
            "gaiji": {
              "type": "object",
              "additionalProperties": false,
              "required": ["raw_marker", "resolved"],
              "properties": {
                "raw_marker": { "type": "string" },
                "reference": { "type": ["string", "null"] },
                "unicode": { "type": ["string", "null"] },
                "ivs": { "type": ["string", "null"] },
                "image_or_glyph_fallback": { "type": ["string", "null"] },
                "resolved": { "type": "boolean" }
              }
            }
          }
        }
      ]
    },
    "editorNoteNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "note"],
          "properties": {
            "type": { "const": "editor-note" },
            "span": { "$ref": "#/$defs/span" },
            "note": { "$ref": "#/$defs/note" }
          }
        }
      ]
    },
    "emphasisNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "style"],
          "anyOf": [
            { "required": ["text"] },
            { "required": ["inline_children"] }
          ],
          "properties": {
            "type": { "const": "emphasis" },
            "span": { "$ref": "#/$defs/span" },
            "text": { "type": "string" },
            "inline_children": {
              "type": "array",
              "items": { "$ref": "#/$defs/inlineNode" }
            },
            "style": { "type": "string" }
          }
        }
      ]
    },
    "layoutSpanNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "text", "layout"],
          "properties": {
            "type": { "const": "layout-span" },
            "span": { "$ref": "#/$defs/span" },
            "text": { "type": "string" },
            "inline_children": {
              "type": "array",
              "items": { "$ref": "#/$defs/inlineNode" }
            },
            "layout": { "$ref": "#/$defs/layoutScope" }
          }
        }
      ]
    },
    "headingNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "text", "level"],
          "properties": {
            "type": { "const": "heading" },
            "span": { "$ref": "#/$defs/span" },
            "text": { "type": "string" },
            "inline_children": {
              "type": "array",
              "items": { "$ref": "#/$defs/inlineNode" }
            },
            "level": { "type": "integer", "minimum": 1, "maximum": 6 }
          }
        }
      ]
    },
    "indentationNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "depth"],
          "properties": {
            "type": { "const": "indentation" },
            "span": { "$ref": "#/$defs/span" },
            "depth": { "type": "integer", "minimum": 0 },
            "text": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "pageBreakNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "marker"],
          "properties": {
            "type": { "const": "page-break" },
            "span": { "$ref": "#/$defs/span" },
            "marker": { "type": "string" },
            "page_number": { "type": ["integer", "null"], "minimum": 1 }
          }
        }
      ]
    },
    "lineBreakNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "marker"],
          "properties": {
            "type": { "const": "line-break" },
            "span": { "$ref": "#/$defs/span" },
            "marker": { "type": "string" }
          }
        }
      ]
    },
    "imageNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "src"],
          "properties": {
            "type": { "const": "image" },
            "span": { "$ref": "#/$defs/span" },
            "src": { "type": "string" },
            "alt": { "type": ["string", "null"] },
            "path_hint": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "captionNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "text"],
          "properties": {
            "type": { "const": "caption" },
            "span": { "$ref": "#/$defs/span" },
            "text": { "type": "string" },
            "target": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "quoteNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "marker_type"],
          "properties": {
            "type": { "const": "quote" },
            "span": { "$ref": "#/$defs/span" },
            "marker_type": { "type": "string", "enum": ["open", "close", "inline", "unknown"] },
            "nesting_level": { "type": ["integer", "null"], "minimum": 0 },
            "text": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "sourceNoteNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "text", "note_type", "placement", "classification", "source_pointer"],
          "properties": {
            "type": { "const": "source-note" },
            "span": { "$ref": "#/$defs/span" },
            "text": { "type": "string" },
            "note_type": { "type": "string", "enum": ["source-attribution", "bibliographic-note", "transcriber-note", "unknown"] },
            "placement": { "type": "string", "enum": ["front", "body", "back", "unknown"] },
            "classification": { "type": "string", "enum": ["direct", "heuristic", "unknown"] },
            "source_pointer": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "category"],
      "properties": {
        "raw": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["emphasis", "heading", "indentation", "page-break", "image", "caption", "external-character", "accent-mark", "ruby", "misc"]
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["severity", "code", "message"],
      "additionalProperties": false,
      "properties": {
        "severity": { "type": "string", "enum": ["fatal", "error", "warning", "info"] },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "message": { "type": "string" },
        "span": {
          "anyOf": [
            { "$ref": "#/$defs/span" },
            { "type": "null" }
          ]
        },
        "construct": { "type": ["string", "null"] },
        "recovery": { "type": ["string", "null"] }
      }
    }
  }
}
