{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/soranoha/schemas/parser-rq-classified-source-ledger.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "ledger_schema_hash",
    "qualification_identity_ref",
    "parser",
    "instrument_version",
    "original_source",
    "decoded_source",
    "policy_id",
    "policy_hash",
    "coordinate_system",
    "parser_status",
    "entries",
    "errors"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "abc/parser-rq-classified-source-ledger/v1"
    },
    "ledger_schema_hash": {
      "$ref": "#/$defs/hash"
    },
    "qualification_identity_ref": {
      "$ref": "#/$defs/hash"
    },
    "parser": {
      "const": "ab-aozora"
    },
    "instrument_version": {
      "type": "string",
      "minLength": 1
    },
    "original_source": {
      "$ref": "#/$defs/blob"
    },
    "decoded_source": {
      "$ref": "#/$defs/decoded"
    },
    "policy_id": {
      "const": "parser-rq-ab-aozora-classified-source-v1"
    },
    "policy_hash": {
      "$ref": "#/$defs/hash"
    },
    "coordinate_system": {
      "const": "decoded_utf8"
    },
    "parser_status": {
      "enum": [
        "complete",
        "unavailable"
      ]
    },
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "parser_status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "errors": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "entries": {
            "maxItems": 0
          },
          "errors": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "role": {
      "enum": [
        "visible_text",
        "structural_newline",
        "ruby",
        "typography",
        "gaiji",
        "layout",
        "break",
        "heading",
        "illustration",
        "kunten",
        "source_annotation",
        "container_syntax",
        "terminal_provenance",
        "publication_metadata",
        "editorial_legend",
        "bibliographic",
        "distribution_notice",
        "editorial_remark",
        "file_provenance",
        "licence_terms",
        "unrecognized_source_form"
      ]
    },
    "disposition": {
      "enum": [
        "emitted_semantic_value",
        "preserved_sidecar_value",
        "structural_control",
        "lossless_normalization",
        "preserved_opaque"
      ]
    },
    "blob": {
      "type": "object",
      "required": [
        "artifact_ref",
        "value_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "value_hash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "decoded": {
      "type": "object",
      "required": [
        "artifact_ref",
        "value_hash",
        "encoding",
        "bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "value_hash": {
          "$ref": "#/$defs/hash"
        },
        "encoding": {
          "enum": [
            "utf-8",
            "utf-8-bom",
            "windows-31j"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "artifact_ref",
        "value_hash",
        "relation"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "value_hash": {
          "$ref": "#/$defs/hash"
        },
        "relation": {
          "enum": [
            "emits",
            "preserves"
          ]
        }
      }
    },
    "witness": {
      "type": "object",
      "required": [
        "construct_id",
        "start",
        "end",
        "source_form"
      ],
      "additionalProperties": false,
      "properties": {
        "construct_id": {
          "enum": [
            "bibliographic_header_line",
            "body_end",
            "container_close",
            "container_open",
            "distribution_notice_line",
            "editorial_legend_entry",
            "editorial_legend_example",
            "editorial_legend_heading",
            "editorial_legend_line",
            "editorial_legend_note",
            "editorial_remark_continuation",
            "editorial_remark_line",
            "editorial_separator_rule",
            "file_dating_line",
            "forced_break",
            "invalid_ruby_span",
            "licence_statement_continuation",
            "licence_statement_line",
            "newline",
            "page_break",
            "publication_metadata_continuation",
            "publication_metadata_line",
            "recovered_verbatim",
            "section_break",
            "unknown_directive",
            "warichu_close",
            "warichu_open"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "source_form": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "normalization": {
      "type": "object",
      "required": [
        "source_form",
        "normalized_form",
        "source_bytes_hash",
        "normalized_bytes_hash",
        "inverse_rule"
      ],
      "additionalProperties": false,
      "properties": {
        "source_form": {
          "type": "string",
          "minLength": 1
        },
        "normalized_form": {
          "type": "string",
          "minLength": 1
        },
        "source_bytes_hash": {
          "$ref": "#/$defs/hash"
        },
        "normalized_bytes_hash": {
          "$ref": "#/$defs/hash"
        },
        "inverse_rule": {
          "enum": [
            "crlf",
            "bare_cr",
            "accent_decomposition"
          ]
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "start",
        "end",
        "construct_id",
        "source_role",
        "disposition",
        "evidence_class",
        "parser_evidence_code"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "construct_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "source_role": {
          "$ref": "#/$defs/role"
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "evidence_class": {
          "enum": [
            "accepted_text",
            "recovered_verbatim",
            "typed_node",
            "structural_token",
            "typed_container",
            "unknown_directive",
            "sanitizer_transform"
          ]
        },
        "target_identity": {
          "$ref": "#/$defs/target"
        },
        "target_pointer": {
          "type": "string",
          "pattern": "^(|/.*)$"
        },
        "parser_evidence_code": {
          "type": "string",
          "minLength": 1
        },
        "construct_witness": {
          "$ref": "#/$defs/witness"
        },
        "normalization_proof": {
          "$ref": "#/$defs/normalization"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": [
                  "emitted_semantic_value",
                  "preserved_sidecar_value",
                  "lossless_normalization"
                ]
              }
            }
          },
          "then": {
            "required": [
              "target_identity"
            ]
          },
          "else": {
            "not": {
              "required": [
                "target_identity"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "structural_control"
              }
            }
          },
          "then": {
            "required": [
              "construct_witness"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "lossless_normalization"
              }
            }
          },
          "then": {
            "required": [
              "normalization_proof"
            ]
          },
          "else": {
            "not": {
              "required": [
                "normalization_proof"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "preserved_opaque"
              }
            }
          },
          "then": {
            "required": [
              "construct_witness"
            ],
            "properties": {
              "source_role": {
                "const": "unrecognized_source_form"
              }
            },
            "not": {
              "required": [
                "target_identity"
              ]
            }
          }
        }
      ]
    }
  }
}
