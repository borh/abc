{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/adr-evidence-run.schema.json",
  "title": "ABC ADR Executable Evidence Run",
  "version": "0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "input_profile", "inputs", "observations"],
  "properties": {
    "schema_version": {"const": "abc-adr-evidence-run-v1"},
    "producer": {"$ref": "#/$defs/producer"},
    "input_profile": {"$ref": "#/$defs/inputProfile"},
    "inputs": {"$ref": "#/$defs/inputs"},
    "observations": {"$ref": "#/$defs/observations"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "safeValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "string"},
        {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
        {"type": "array", "items": {"$ref": "#/$defs/safeValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/safeValue"}}
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "command", "revision"],
      "properties": {
        "tool": {"$ref": "#/$defs/nonEmptyString"},
        "command": {"$ref": "#/$defs/nonEmptyString"},
        "revision": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "inputProfile": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "roots", "explicit"],
          "properties": {
            "kind": {"enum": ["clojure-test-v1", "repo-files-v1"]},
            "roots": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
            "explicit": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "component_root", "roots", "explicit"],
          "properties": {
            "kind": {"const": "component-clojure-test-v1"},
            "component_root": {"$ref": "#/$defs/nonEmptyString"},
            "roots": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
            "explicit": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}}
          }
        }
      ]
    },
    "inputs": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/hash"}
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {"$ref": "#/$defs/safeValue"},
        "details": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/safeValue"}
        }
      }
    },
    "observations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9-]*$"},
      "additionalProperties": {"$ref": "#/$defs/observation"}
    }
  }
}
