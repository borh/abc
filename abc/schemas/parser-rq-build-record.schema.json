{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-build-record.schema.json",
  "title": "Parser RQ independently realized build record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "build_id", "store_uri", "initially_empty", "target_absent_before_seed", "target_absent_after_seed", "drv_path", "output_path", "output_ref", "nar_hash", "seeded_inputs", "build_log", "executables"],
  "properties": {
    "schema_id": {"const": "https://w3id.org/abc/schemas/parser-rq-build-record.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "build_id": {"enum": ["build-a", "build-b"]},
    "store_uri": {"type": "string", "minLength": 1},
    "initially_empty": {"const": true},
    "target_absent_before_seed": {"const": true},
    "target_absent_after_seed": {"const": true},
    "drv_path": {"type": "string", "pattern": "^/nix/store/[0-9a-z]{32}-.+\\.drv$"},
    "output_path": {"type": "string", "pattern": "^/nix/store/[0-9a-z]{32}-.+"},
    "output_ref": {"$ref": "#/$defs/hash"},
    "nar_hash": {"$ref": "#/$defs/hash"},
    "seeded_inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/nix/store/"}},
    "build_log": {"$ref": "#/$defs/blob"},
    "executables": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/executable"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "blob": {"type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "media_type", "locator"], "properties": {"sha256": {"$ref": "#/$defs/hash"}, "bytes": {"type": "integer", "minimum": 0}, "media_type": {"type": "string", "minLength": 1}, "locator": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}}},
    "executable": {"type": "object", "additionalProperties": false, "required": ["name", "nix_output", "nar_hash", "sha256", "bytes", "adapter", "adapter_version", "parser_git_rev", "argv_template"], "properties": {"name": {"type": "string", "minLength": 1}, "nix_output": {"type": "string", "pattern": "^/nix/store/"}, "nar_hash": {"$ref": "#/$defs/hash"}, "sha256": {"$ref": "#/$defs/hash"}, "bytes": {"type": "integer", "minimum": 1}, "adapter": {"type": "string", "minLength": 1}, "adapter_version": {"type": "string", "minLength": 1}, "parser_git_rev": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "argv_template": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}
  }
}
