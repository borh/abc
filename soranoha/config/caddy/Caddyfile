# The serving configuration for one exported soranoha serving tree.
# The environment supplies the deployment-specific values:
#   SORANOHA_SERVE_LISTEN  host:port to listen on
#   SORANOHA_SERVE_ROOT    path of the exported serving tree
# Every response is a file from the tree: static file serving only, no
# directory listings, no body rewriting. Digest-addressed paths (blobs,
# manifests, signatures, governance events) are immutable; the pointer
# layer (releases/latest, releases/HEAD, catalog.json, works/, withdrawn/) and
# the generated browse layer — pages and the pre-built bulk archives under
# bulk/ — are short-cache, since they move with each release. A bulk archive
# is large but not immutable: the same URL holds different bytes at the next
# release, so it takes the pointer layer's cache policy and not the blob
# layer's. Updating this file requires bumping the rev + hash pin in the
# estate's soranoha-serve.nix, which is what keeps serving policy immutable
# system state rather than release data.
#
# try_files gives the browse pages extensionless URLs (/rights -> rights.html,
# /works/<id>/read -> read.html) without rewriting any body. It is tried after
# the literal path, so it can never shadow a chain file: /works/<id>/tei
# resolves to the symlink, and only a path with no file behind it falls through
# to its .html page. The reading view therefore needs no route of its own — it
# lives under the work's existing short-cache prefix.
{
	admin off
	auto_https off
	persist_config off
}

http://{$SORANOHA_SERVE_LISTEN} {
	root * {$SORANOHA_SERVE_ROOT}

	# immutable only when the file exists: a digest-addressed 404 must
	# never be retained, since the same URL can begin existing at the
	# next serving-tree activation
	@immutable {
		path /blobs/sha256/* /governance/* /releases/*.json /releases/*.sig
		file
	}
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@pointer path /releases/latest /releases/HEAD /catalog.json /works/* /withdrawn/*
	header @pointer Cache-Control "public, max-age=60"

	# generated presentation: a projection of this release, replaced whole at
	# the next activation, so it is cached like the pointer layer and never
	# like a digest-addressed file
	@browse path / /index.html /style.css /search.js /copy.js /search-index.json /authors /authors/* /titles /titles/* /ndc /ndc/* /bulk/* /rights /citation /history /ns/* /license/* /schemas/*
	header @browse Cache-Control "public, max-age=60"

	try_files {path} {path}.html

	file_server
}
