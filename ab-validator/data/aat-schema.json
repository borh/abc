        "interpretation_facts": {"type":"array", "items":{"$ref":"#/$defs/interpretationFact"}},
        "interpretation_problems": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["kind","code","aspects","influence","raw","source_span"],"properties":{"kind":{"$ref":"#/$defs/raw/properties/interpretation_problem/properties/kind"},"code":{"$ref":"#/$defs/raw/properties/interpretation_problem/properties/code"},"aspects":{"$ref":"#/$defs/raw/properties/interpretation_problem/properties/aspects"},"influence":{"$ref":"#/$defs/raw/properties/interpretation_problem/properties/influence"},"raw":{"type":"string"},"source_span":{"$ref":"#/$defs/interpretationFact/properties/source_span"}},"allOf":[{"if":{"properties":{"kind":{"const":"content-outside-primary-input"}}},"then":{"properties":{"code":{"const":"content-outside-primary-input"},"aspects":{"const":["content"]},"influence":{"const":{"kind":"source-location"}}}},"else":{"properties":{"code":{"not":{"const":"content-outside-primary-input"}},"influence":{"const":{"kind":"document"}}}}}]}},
        "metrics": { "$ref": "#/$defs/metrics" },
        "semantic_summary": { "$ref": "#/$defs/semantic_summary" }
