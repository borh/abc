{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-site-preflight.schema.json",
  "title": "Parser RQ disposable site preflight report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "report_ref", "evidence_git_rev", "evidence_tree_clean", "site_descriptor_hash", "site_policy_hash", "production_graph_hash", "independent_build_capability", "site_facts"],
  "properties": {
    "schema_id": {"const": "https://w3id.org/abc/schemas/parser-rq-site-preflight.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "report_ref": {"$ref": "#/$defs/hash"},
    "evidence_git_rev": {"$ref": "#/$defs/git"},
    "evidence_tree_clean": {"const": true},
    "site_descriptor_hash": {"$ref": "#/$defs/hash"},
    "site_policy_hash": {"$ref": "#/$defs/hash"},
    "production_graph_hash": {"$ref": "#/$defs/hash"},
    "independent_build_capability": {"const": "passed"},
    "site_facts": {"$ref": "#/$defs/siteFacts"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "git": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "mount": {"type": "object", "additionalProperties": false, "required": ["root", "source", "filesystem_type", "filesystem_id"], "properties": {"root": {"type": "string", "pattern": "^/"}, "source": {"type": "string", "minLength": 1}, "filesystem_type": {"type": "string", "minLength": 1}, "filesystem_id": {"type": "string", "minLength": 1}, "remote_authority": {"type": "string", "minLength": 1}}},
    "probe": {"type": "object", "additionalProperties": false, "required": ["create", "fsync_file", "fsync_directory", "stream_read", "remove"], "properties": {"create": {"const": true}, "fsync_file": {"const": true}, "fsync_directory": {"const": true}, "stream_read": {"const": true}, "remove": {"const": true}}},
    "siteFacts": {"type": "object", "additionalProperties": false, "required": ["kernel_hostname", "stable_host_label", "stable_addresses", "local_addresses", "primary_mount", "replica_mount", "clock_synchronized", "lock_available", "replica_probe"], "properties": {"kernel_hostname": {"type": "string", "minLength": 1}, "stable_host_label": {"type": "string", "minLength": 1}, "stable_addresses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "local_addresses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "primary_mount": {"$ref": "#/$defs/mount"}, "replica_mount": {"$ref": "#/$defs/mount"}, "clock_synchronized": {"const": true}, "lock_available": {"const": true}, "replica_probe": {"$ref": "#/$defs/probe"}}}
  }
}
