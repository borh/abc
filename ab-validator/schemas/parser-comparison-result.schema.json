{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soranoha.example/schemas/parser-comparison-result.schema.json",
  "title": "Soranoha parser comparison result IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "rows"],
  "properties": {
    "schema_version": {"const": 1},
    "study_id": {"type": "string", "minLength": 1},
    "rows": {"type": "array", "minItems": 108, "maxItems": 108, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "axis", "measurement_mode", "parser_revision", "adapter_revision", "corpus_hash", "status", "numerator", "denominator", "missingness", "caveats", "provenance"],
      "allOf": [
        {
          "if": {"properties": {"measurement_mode": {"const": "native"}}},
          "then": {"properties": {"adapter_revision": {"type": "null"}, "provenance": {"allOf": [{"contains": {"const": "native_parser"}}, {"not": {"contains": {"enum": ["adapter", "source_lexer_fallback", "mapper"]}}}]}}}
        },
        {
          "if": {"properties": {"measurement_mode": {"const": "adapter_normalized"}}},
          "then": {"properties": {"adapter_revision": {"type": "string", "minLength": 1}, "provenance": {"contains": {"enum": ["adapter", "source_lexer_fallback", "mapper"]}}}}
        },
        {
          "if": {"properties": {"status": {"const": "measured"}}},
          "then": {"properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer"}, "missingness": {"const": "none"}}},
          "else": {"properties": {"numerator": {"type": "null"}, "denominator": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"const": "failed"}}},
          "then": {"properties": {"missingness": {"enum": ["unavailable", "build-failure", "run-failure", "timeout"]}}}
        },
        {
          "if": {"properties": {"status": {"const": "non_comparable"}}},
          "then": {"properties": {"missingness": {"enum": ["not-applicable", "non-comparable"]}}}
        },
        {
          "if": {"properties": {"candidate": {"enum": ["aozora-parser.js", "ab-aozora"]}}},
          "then": {"properties": {"measurement_mode": {"const": "native"}}}
        }
      ],
      "properties": {
        "candidate": {"enum": ["aozora", "aozora2", "aozora-rs", "aozora2html", "aozora-epub3", "aozora-parser.js", "ab-aozora"]},
        "axis": {"enum": ["construct_coverage", "fidelity", "robustness", "diagnostics", "spans", "performance", "maintenance", "packaging", "license"]},
        "measurement_mode": {"enum": ["native", "adapter_normalized"]},
        "parser_revision": {"type": "string", "minLength": 1},
        "adapter_revision": {"type": ["string", "null"]},
        "corpus_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "status": {"enum": ["measured", "failed", "non_comparable"]},
        "numerator": {"type": ["integer", "null"], "minimum": 0},
        "denominator": {"type": ["integer", "null"], "minimum": 0},
        "missingness": {"enum": ["none", "not-applicable", "unavailable", "build-failure", "run-failure", "timeout", "non-comparable"]},
        "caveats": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "provenance": {"type": "array", "minItems": 1, "items": {"enum": ["native_parser", "adapter", "source_lexer_fallback", "mapper", "source_authority"]}}
      }
    }
  }
}
