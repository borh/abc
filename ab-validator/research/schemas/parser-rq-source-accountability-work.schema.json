{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-rq-source-accountability-work.schema.json",
  "title": "Parser release qualification source-accountability work record",
  "description": "v2. Records which source, decoded how, which parser-IR, which diagnostics, under which taxonomy, authenticated against which qualification identity. It publishes no measurement: v1 also carried a node-span coverage quantity and the whole-file eligibility it was measured against, and both were retired together. Published v1 records are validated by parser-rq-source-accountability-work-v1.schema.json. See docs/adr/parser-rq-retire-node-span-coverage.md.",
  "type": "object",
  "required": ["schema_version", "identity_ref", "instrument_version", "work_id", "original_source", "decoded_source", "parser_ir", "taxonomy_version", "taxonomy_hash", "coordinate_system", "status", "errors"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "abc/parser-rq-source-accountability-work/v2"},
    "identity_ref": {"$ref": "#/$defs/hash"},
    "instrument_version": {"type": "string", "minLength": 1},
    "work_id": {"type": "string", "minLength": 1},
    "original_source": {"$ref": "#/$defs/blob"},
    "decoded_source": {"$ref": "#/$defs/decoded_blob"},
    "parser_ir": {"$ref": "#/$defs/parser_ir_blob"},
    "diagnostics": {"$ref": "#/$defs/logical_blob"},
    "taxonomy_version": {"const": "parser-rq-ignored-regions-v1"},
    "taxonomy_hash": {"$ref": "#/$defs/hash"},
    "coordinate_system": {"const": "decoded_utf8"},
    "status": {"enum": ["ok", "unavailable"]},
    "errors": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ok"}}},
      "then": {
        "required": ["diagnostics"],
        "properties": {
          "decoded_source": {
            "properties": {"encoding": {"enum": ["utf-8", "utf-8-bom", "windows-31j"]}}
          },
          "errors": {"maxItems": 0}
        }
      },
      "else": {"properties": {"errors": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "blob": {
      "type": "object",
      "required": ["sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "sha256": {"$ref": "#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "decoded_blob": {
      "type": "object",
      "required": ["sha256", "bytes", "encoding"],
      "additionalProperties": false,
      "properties": {
        "sha256": {"$ref": "#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 0},
        "encoding": {"enum": ["utf-8", "utf-8-bom", "windows-31j", "windows-31j-lossy"]}
      }
    },
    "parser_ir_blob": {
      "type": "object",
      "required": ["schema_id", "schema_hash", "sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "schema_id": {"type": "string", "format": "uri"},
        "schema_hash": {"$ref": "#/$defs/hash"},
        "sha256": {"$ref": "#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "logical_blob": {
      "type": "object",
      "required": ["profile", "sha256", "bytes", "media_type", "locator"],
      "additionalProperties": false,
      "properties": {
        "profile": {"const": "abc/raw-parser-diagnostics-schema-v3"},
        "sha256": {"$ref": "#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 0},
        "media_type": {"const": "application/json"},
        "locator": {"type": "string", "minLength": 1}
      }
    }
  }
}
