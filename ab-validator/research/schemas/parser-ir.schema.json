{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-ir.schema.json",
  "title": "ABC Parser IR",
  "version": "0.14.0",
  "type": "object",
  "required": ["schema_id", "schema_hash", "source", "nodes", "warnings", "errors", "interpretation_problems"],
  "additionalProperties": false,
  "properties": {
    "schema_id": { "type": "string" },
    "schema_hash": { "$ref": "#/$defs/hash" },
    "derived_from": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "aat_version",
        "aat_adapter",
        "parse_complete",
        "mapping_id",
        "mapping_version",
        "mapping_schema_hash"
      ],
      "properties": {
        "aat_version": { "type": "integer", "minimum": 1 },
        "aat_adapter": { "type": "string" },
        "aat_adapter_version": { "type": ["string", "null"] },
        "parse_complete": { "type": "boolean" },
        "mapping_id": { "type": "string", "format": "uri" },
        "mapping_version": { "type": "string" },
        "mapping_schema_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "source": {
      "type": "object",
      "required": ["work_content_hash", "encoding", "decode_outcome", "normalization"],
      "additionalProperties": false,
      "properties": {
        "work_content_hash": { "$ref": "#/$defs/hash" },
        "primary_text_hash": { "$ref": "#/$defs/hash" },
        "source_path": { "type": ["string", "null"] },
        "encoding": { "type": "string", "enum": ["Shift_JIS", "UTF-8", "EUC-JP", "unknown"] },
        "decode_outcome": { "enum": ["utf-8", "utf-8-bom", "windows-31j", "windows-31j-lossy"] },
        "normalization": { "type": "string", "enum": ["source", "NFC", "NFKC"] }
      }
    },
    "interpretation_problems": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "code", "raw", "source_span", "aspects", "influence"],
        "properties": {
          "kind": {"const": "unknown-notation"}, "code": {"const": "unknown-notation"},
          "raw": {"type": "string"}, "source_span": {"$ref": "#/$defs/sourceSpan"},
          "aspects": {"const": ["content", "structure", "layout"]},
          "influence": {"const": {"kind": "document"}}
        }
      }
    },
    "layout_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["paragraph_range", "indent", "source_pointer"],
        "additionalProperties": false,
        "properties": {
          "paragraph_range": { "$ref": "#/$defs/nodeRange", "description": "Half-open indices into paragraphs, delimiting one enclosing layout block." },
          "indent": { "type": "integer", "minimum": 0 },
          "direction": { "const": "horizontal" },
          "align": { "const": "center" },
          "border": { "const": "solid" },
          "source_pointer": { "type": "string" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "paragraphs": {
      "type": "array",
      "items": { "$ref": "#/$defs/paragraph" },
      "default": []
    },
    "sentence_segmentation": { "$ref": "#/$defs/sentenceSegmentation" },
    "sentences": {
      "type": "array",
      "items": { "$ref": "#/$defs/sentence" },
      "default": []
    },
    "orthographic_annotations": { "$ref": "#/$defs/orthographicAnnotations" },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "span": {
      "type": "object",
      "$comment": "Half-open UTF-8 byte offsets in the converter's parser text projection, before publication whitespace filtering. parser_text_utf8 includes structural and source-note text traversed by the converter. reading_utf8 is local to the containing ruby reading; each nested ruby reading owns a new axis starting at zero. Neither axis is the decoded source or final plaintext. end must be greater than or equal to start.",
      "required": ["start", "end", "coordinate_system"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "coordinate_system": { "enum": ["parser_text_utf8", "reading_utf8"] }
      }
    },
    "sourceSpan": {
      "type": "object",
      "$comment": "Exact half-open UTF-8 byte extent in the complete decoded source, including source markup. Source extents are absent when an exact mapping is unknown, including newly split fragments. line and column refer to the source and are 1-based when known.",
      "required": ["start", "end", "coordinate_system"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "end_line": { "type": ["integer", "null"], "minimum": 1 },
        "column": { "type": ["integer", "null"], "minimum": 1 },
        "coordinate_system": { "const": "decoded_utf8" }
      }
    },
    "baseNode": {
      "type": "object",
      "required": ["type", "span"],
      "properties": {
        "type": { "type": "string" },
        "span": { "$ref": "#/$defs/span" },
        "source_span": { "$ref": "#/$defs/sourceSpan" }
      }
    },
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/textNode" },
        { "$ref": "#/$defs/rubyNode" },
        { "$ref": "#/$defs/gaijiNode" },
        { "$ref": "#/$defs/editorNoteNode" },
        { "$ref": "#/$defs/baseTextVariantNode" },
        { "$ref": "#/$defs/warichuNode" },
        { "$ref": "#/$defs/emphasisNode" },
        { "$ref": "#/$defs/layoutSpanNode" },
        { "$ref": "#/$defs/headingNode" },
        { "$ref": "#/$defs/indentationNode" },
        { "$ref": "#/$defs/pageBreakNode" },
        { "$ref": "#/$defs/lineBreakNode" },
        { "$ref": "#/$defs/imageNode" },
        { "$ref": "#/$defs/captionNode" },
        { "$ref": "#/$defs/quoteNode" },
        { "$ref": "#/$defs/sourceNoteNode" }
      ]
    },
    "inlineNode": {
      "oneOf": [
        { "$ref": "#/$defs/textNode" },
        { "$ref": "#/$defs/rubyNode" },
        { "$ref": "#/$defs/gaijiNode" },
        { "$ref": "#/$defs/editorNoteNode" },
        { "$ref": "#/$defs/baseTextVariantNode" },
        { "$ref": "#/$defs/warichuNode" },
        { "$ref": "#/$defs/emphasisNode" },
        { "$ref": "#/$defs/layoutSpanNode" },
        { "$ref": "#/$defs/lineBreakNode" }
      ]
    },
    "nodeRange": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "byteRange": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "sentenceSegmentation": {
      "type": "object",
      "required": ["schema_version", "splitter_id", "coordinate_system", "coverage"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "sentence-segmentation-v1" },
        "splitter_id": { "enum": ["ab-plaintext-japanese-v1", "ab-plaintext-japanese-v2"] },
        "coordinate_system": { "const": "parser_text_utf8" },
        "coverage": { "const": "body-paragraphs" }
      }
    },
    "sentence": {
      "type": "object",
      "required": [
        "id",
        "paragraph_id",
        "span",
        "node_range",
        "tags",
        "orthographic_annotation_indices"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^s[0-9]{6}$" },
        "paragraph_id": { "type": "string", "pattern": "^p[0-9]{6}$" },
        "span": { "$ref": "#/$defs/span" },
        "node_range": { "$ref": "#/$defs/nodeRange" },
        "tags": {
          "type": "array",
          "items": { "enum": ["orthographic-katakana"] },
          "uniqueItems": true
        },
        "orthographic_annotation_indices": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "uniqueItems": true
        },
        "part": {
          "type": "string",
          "enum": ["I", "M", "F"],
          "description": "Fragment position for TEI Chapter 21 fragmented sentences. Absent for complete sentences."
        },
        "fragment_group": {
          "type": "string",
          "pattern": "^fg[0-9]{6}$",
          "description": "Parser-IR-internal grouping key linking fragments of one logical sentence. Not rendered in TEI."
        },
        "next_id": {
          "type": "string",
          "pattern": "^s[0-9]{6}$",
          "description": "ID of the next fragment in the group (parser-IR-internal; rendered as TEI @next)."
        },
        "prev_id": {
          "type": "string",
          "pattern": "^s[0-9]{6}$",
          "description": "ID of the previous fragment in the group (parser-IR-internal; rendered as TEI @prev)."
        }
      }
    },
    "orthographicAnnotations": {
      "type": "object",
      "required": [
        "work_id",
        "coordinate_system",
        "detector_id",
        "annotations"
      ],
      "anyOf": [
        { "required": ["primary_text_hash"] },
        { "required": ["work_content_hash"] }
      ],
      "additionalProperties": false,
      "properties": {
        "work_id": { "type": "string" },
        "primary_text_hash": { "$ref": "#/$defs/hash" },
        "work_content_hash": { "$ref": "#/$defs/hash" },
        "coordinate_system": { "const": "parser_text_utf8" },
        "detector_id": { "$ref": "#/$defs/orthoDetectorId" },
        "annotations": {
          "type": "array",
          "items": { "$ref": "#/$defs/orthographicAnnotation" }
        }
      }
    },
    "orthographicAnnotation": {
      "type": "object",
      "required": ["source_byte_range", "normalized_text", "kind", "confidence"],
      "additionalProperties": false,
      "properties": {
        "source_byte_range": { "$ref": "#/$defs/byteRange", "description": "Range in the detector input, on the enclosing bundle parser_text_utf8 axis." },
        "normalized_text": { "type": "string" },
        "kind": { "enum": ["ScriptKatakanaToHiragana", "HistoricalToModern"] },
        "confidence": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 }
      }
    },
    "orthoDetectorId": {
      "oneOf": [
        { "const": "HeuristicV1" },
        {
          "type": "object",
          "required": ["MlLogisticRegression"],
          "additionalProperties": false,
          "properties": {
            "MlLogisticRegression": {
              "type": "object",
              "required": ["model_hash"],
              "additionalProperties": false,
              "properties": {
                "model_hash": { "$ref": "#/$defs/hash" }
              }
            }
          }
        }
      ]
    },
    "paragraphLayout": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "source", "indent"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "jisage" },
            "source": { "$ref": "#/$defs/paragraphLayoutSource" },
            "indent": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "source", "first_line_indent", "continuation_indent"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "burasage" },
            "source": { "$ref": "#/$defs/paragraphLayoutSource" },
            "first_line_indent": { "type": "integer", "minimum": 0 },
            "continuation_indent": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "source", "align", "offset_from_end"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "chitsuki" },
            "source": { "$ref": "#/$defs/paragraphLayoutSource" },
            "align": { "type": "string", "enum": ["right"] },
            "offset_from_end": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "source", "width"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "jizume" },
            "source": { "$ref": "#/$defs/paragraphLayoutSource" },
            "width": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "source", "indent"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "line-jisage" },
            "source": { "$ref": "#/$defs/paragraphLayoutSource" },
            "indent": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "paragraphLayoutSource": {
      "type": "string",
      "enum": ["aat-block", "aat-style", "source-derived", "heuristic"]
    },
    "layoutScopeSource": {
      "type": "string",
      "enum": ["aat-inline", "aat-block", "source-derived", "heuristic"]
    },
    "layoutScope": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "source", "size_type", "level"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "font-size" },
            "source": { "$ref": "#/$defs/layoutScopeSource" },
            "size_type": { "type": "string" },
            "level": { "type": "integer", "minimum": 0 },
            "marker": { "type": ["string", "null"] }
          }
        },
        {
          "type": "object",
          "required": ["kind", "source"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "tcy" },
            "source": { "$ref": "#/$defs/layoutScopeSource" },
            "marker": { "type": ["string", "null"] }
          }
        },
        {
          "type": "object",
          "required": ["kind", "source"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "keigakomi" },
            "source": { "$ref": "#/$defs/layoutScopeSource" },
            "border": { "type": ["string", "null"] },
            "marker": { "type": ["string", "null"] }
          }
        },
        {
          "type": "object",
          "required": ["kind", "source", "direction"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "yokogumi" },
            "source": { "$ref": "#/$defs/layoutScopeSource" },
            "direction": { "type": "string", "enum": ["horizontal"] },
            "marker": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "paragraph": {
      "type": "object",
      "required": ["id", "span", "span_source", "node_range", "role", "source_pointer", "classification"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^p[0-9]{6}$" },
        "span": { "$ref": "#/$defs/span" },
        "source_span": { "$ref": "#/$defs/sourceSpan" },
        "span_source": { "type": "string", "enum": ["direct", "derived", "synthesized", "unknown"] },
        "node_range": { "$ref": "#/$defs/nodeRange" },
        "role": { "type": "string", "enum": ["body", "source-note", "unknown"] },
        "source_pointer": { "type": ["string", "null"] },
        "classification": { "type": "string", "enum": ["direct", "heuristic", "unknown"] },
        "layout": { "$ref": "#/$defs/paragraphLayout" }
      }
    },
    "textNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "text"],
          "properties": {
            "type": { "const": "text" },
            "span": { "$ref": "#/$defs/span" },
            "source_span": { "$ref": "#/$defs/sourceSpan" },
            "text": { "type": "string" }
          }
        }
      ]
    },
    "gaiji": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_marker",
        "resolved"
      ],
      "properties": {
        "raw_marker": {
          "type": "string"
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "unicode": {
          "type": [
            "string",
            "null"
          ]
        },
        "ivs": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_or_glyph_fallback": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved": {
          "type": "boolean"
        }
      }
    },
    "warichuNode": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "span", "text"],
      "oneOf": [{"required": ["inline_children"]}, {"required": ["upper_children", "lower_children"]}],
      "properties": {
        "type": {"const": "warichu"}, "span": {"$ref": "#/$defs/span"},
        "source_span": {"$ref": "#/$defs/sourceSpan"}, "text": {"type": "string"},
        "inline_children": {"type": "array", "items": {"$ref": "#/$defs/inlineNode"}},
        "upper_children": {"type": "array", "items": {"$ref": "#/$defs/inlineNode"}},
        "lower_children": {"type": "array", "items": {"$ref": "#/$defs/inlineNode"}}
      }
    },
    "rubyReadingNode": {
      "allOf": [
        { "$ref": "#/$defs/inlineNode" },
        { "properties": { "span": { "properties": { "coordinate_system": { "const": "reading_utf8" } } } } }
      ]
    },
    "baseTextVariantNode": {
      "type": "object",
      "required": ["type", "span", "text", "inline_children", "variant"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "base-text-variant" },
        "span": { "$ref": "#/$defs/span" },
        "source_span": { "$ref": "#/$defs/sourceSpan" },
        "text": { "type": "string" },
        "inline_children": { "type": "array", "items": { "$ref": "#/$defs/inlineNode" } },
        "variant": {
          "type": "object", "required": ["base_text"], "additionalProperties": false,
          "properties": { "base_text": { "type": "string" } }
        }
      }
    },
    "rubyNode": {
      "allOf": [
        {
          "$ref": "#/$defs/baseNode"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "span",
            "ruby"
          ],
          "properties": {
            "type": {
              "const": "ruby"
            },
            "span": {
              "$ref": "#/$defs/span"
            },
            "source_span": {
              "$ref": "#/$defs/sourceSpan"
            },
            "inline_children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inlineNode"
              }
            },
            "ruby": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "base",
                "reading",
                "scope"
              ],
              "properties": {
                "base": {
                  "type": "string"
                },
                "reading": {
                  "type": "string"
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "explicit",
                    "inferred",
                    "group",
                    "mid-word",
                    "ambiguous"
                  ]
                },
                "direction": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "left",
                    "right",
                    null
                  ],
                  "description": "Ruby reading placement relative to base text: left (before base) or right (after base)."
                }
              }
            },
            "reading_children": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/rubyReadingNode"
              },
              "description": "Structured ruby reading content. Reading spans use reading_utf8 relative to this ruby reading, not the body axis. source_span locates exact decoded source extents when known."
            }
          }
        }
      ]
    },
    "gaijiNode": {
      "allOf": [
        {
          "$ref": "#/$defs/baseNode"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "span",
            "gaiji"
          ],
          "properties": {
            "type": {
              "const": "gaiji"
            },
            "span": {
              "$ref": "#/$defs/span"
            },
            "source_span": {
              "$ref": "#/$defs/sourceSpan"
            },
            "gaiji": {
              "$ref": "#/$defs/gaiji"
            }
          }
        }
      ]
    },
    "editorNoteNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "note"],
          "properties": {
            "type": { "const": "editor-note" },
            "span": { "$ref": "#/$defs/span" },
            "source_span": { "$ref": "#/$defs/sourceSpan" },
            "note": { "$ref": "#/$defs/note" }
          }
        }
      ]
    },
    "emphasisNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "style"],
          "anyOf": [
            { "required": ["text"] },
            { "required": ["inline_children"] }
          ],
          "properties": {
            "type": { "const": "emphasis" },
            "span": { "$ref": "#/$defs/span" },
            "source_span": { "$ref": "#/$defs/sourceSpan" },
            "text": { "type": "string" },
            "inline_children": {
              "type": "array",
              "items": { "$ref": "#/$defs/inlineNode" }
            },
            "decoration": {"type":"object", "additionalProperties":false, "required":["kind","position"], "properties":{"kind":{"type":"string"}, "position":{"enum":["right","left","both","unknown"]}}},
            "style": { "type": "string" }
          }
        }
      ]
    },
    "layoutSpanNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "text", "layout"],
          "properties": {
            "type": { "const": "layout-span" },
            "span": { "$ref": "#/$defs/span" },
            "source_span": { "$ref": "#/$defs/sourceSpan" },
            "text": { "type": "string" },
            "inline_children": {
              "type": "array",
              "items": { "$ref": "#/$defs/inlineNode" }
            },
            "layout": { "$ref": "#/$defs/layoutScope" }
          }
        }
      ]
    },
    "headingNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "text", "level"],
          "properties": {
            "type": { "const": "heading" },
            "span": { "$ref": "#/$defs/span" },
            "source_span": { "$ref": "#/$defs/sourceSpan" },
            "text": { "type": "string" },
            "inline_children": {
              "type": "array",
              "items": { "$ref": "#/$defs/inlineNode" }
            },
            "indent": { "type": "integer", "minimum": 0 },
            "level": { "type": "integer", "minimum": 1, "maximum": 6 }
          }
        }
      ]
    },
    "indentationNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "depth"],
          "properties": {
            "type": { "const": "indentation" },
            "span": { "$ref": "#/$defs/span" },
            "source_span": { "$ref": "#/$defs/sourceSpan" },
            "depth": { "type": "integer", "minimum": 0 },
            "text": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "pageBreakNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "marker"],
          "properties": {
            "type": { "const": "page-break" },
            "span": { "$ref": "#/$defs/span" },
            "source_span": { "$ref": "#/$defs/sourceSpan" },
            "marker": { "type": "string" },
            "page_number": { "type": ["integer", "null"], "minimum": 1 }
          }
        }
      ]
    },
    "lineBreakNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "marker"],
          "properties": {
            "type": { "const": "line-break" },
            "span": { "$ref": "#/$defs/span" },
            "source_span": { "$ref": "#/$defs/sourceSpan" },
            "marker": { "type": "string" }
          }
        }
      ]
    },
    "imageNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "src"],
          "properties": {
            "type": { "const": "image" },
            "span": { "$ref": "#/$defs/span" },
            "source_span": { "$ref": "#/$defs/sourceSpan" },
            "src": { "type": "string" },
            "alt": { "type": ["string", "null"] },
            "path_hint": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "captionNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "text"],
          "properties": {
            "type": { "const": "caption" },
            "span": { "$ref": "#/$defs/span" },
            "source_span": { "$ref": "#/$defs/sourceSpan" },
            "text": { "type": "string" },
            "target": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "quoteNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "marker_type"],
          "properties": {
            "type": { "const": "quote" },
            "span": { "$ref": "#/$defs/span" },
            "source_span": { "$ref": "#/$defs/sourceSpan" },
            "marker_type": { "type": "string", "enum": ["open", "close", "inline", "unknown"] },
            "nesting_level": { "type": ["integer", "null"], "minimum": 0 },
            "text": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "sourceNoteNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "span", "text", "note_type", "placement", "classification", "source_pointer"],
          "properties": {
            "type": { "const": "source-note" },
            "span": { "$ref": "#/$defs/span" },
            "source_span": { "$ref": "#/$defs/sourceSpan" },
            "text": { "type": "string" },
            "note_type": { "type": "string", "enum": ["source-attribution", "bibliographic-note", "transcriber-note", "unknown"] },
            "placement": { "type": "string", "enum": ["front", "body", "back", "unknown"] },
            "classification": { "type": "string", "enum": ["direct", "heuristic", "unknown"] },
            "source_pointer": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "category"],
      "properties": {
        "resolution": { "const": "unresolved" },
        "raw": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["emphasis", "heading", "indentation", "page-break", "image", "caption", "external-character", "accent-mark", "ruby", "correction", "variant", "misc"]
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["severity", "code", "message"],
      "additionalProperties": false,
      "properties": {
        "severity": { "type": "string", "enum": ["fatal", "error", "warning", "info", "note"] },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "span": {
          "anyOf": [
            { "$ref": "#/$defs/sourceSpan" },
            { "type": "null" }
          ]
        },
        "construct": { "type": ["string", "null"] },
        "recovery": { "type": ["string", "null"] }
      }
    }
  }
}
