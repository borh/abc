{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/abc/schemas/parser-ir-publication-preservation.schema.json",
  "title": "ABC Parser-IR Publication Preservation Sidecar",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "schema_hash",
    "parser_ir",
    "tei",
    "source",
    "producer",
    "mapping",
    "coverage",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "https://w3id.org/abc/schemas/parser-ir-publication-preservation.schema.json"
    },
    "schema_version": {
      "const": "0.2.0"
    },
    "schema_hash": {
      "$ref": "#/$defs/hash"
    },
    "parser_ir": {
      "type": "object",
      "required": ["schema_id", "schema_hash", "work_id"],
      "additionalProperties": false,
      "properties": {
        "schema_id": { "type": "string", "format": "uri" },
        "schema_hash": { "$ref": "#/$defs/hash" },
        "work_id": { "type": ["string", "null"] }
      }
    },
    "tei": {
      "type": "object",
      "required": ["profile_id", "profile_hash"],
      "additionalProperties": false,
      "properties": {
        "profile_id": { "type": "string" },
        "profile_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "corpus_snapshot_hash",
        "work_content_hash",
        "source_path",
        "encoding",
        "normalization"
      ],
      "additionalProperties": false,
      "properties": {
        "corpus_snapshot_hash": { "$ref": "#/$defs/hash" },
        "work_content_hash": { "$ref": "#/$defs/hash" },
        "source_path": { "type": ["string", "null"] },
        "encoding": { "type": ["string", "null"] },
        "normalization": { "type": ["string", "null"] }
      }
    },
    "producer": {
      "type": "object",
      "required": ["agent", "generated_at"],
      "additionalProperties": false,
      "properties": {
        "agent": { "type": "string" },
        "generated_at": { "type": "string" }
      }
    },
    "mapping": {
      "type": ["object", "null"],
      "required": ["mapping_id", "mapping_version", "mapping_schema_hash"],
      "additionalProperties": false,
      "properties": {
        "mapping_id": { "type": ["string", "null"] },
        "mapping_version": { "type": ["string", "null"] },
        "mapping_schema_hash": { "$ref": "#/$defs/nullableHash" }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["record_count", "classes"],
      "additionalProperties": false,
      "properties": {
        "record_count": { "type": "integer", "minimum": 0 },
        "classes": {
          "type": "array",
          "items": {
            "enum": ["custom_sidecar", "tei_profile_projection"]
          },
          "uniqueItems": true
        }
      }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableHash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "jsonScalar": {
      "type": ["string", "integer", "number", "boolean", "null"]
    },
    "record": {
      "type": "object",
      "required": [
        "record_id",
        "ir_pointer",
        "tei_pointer",
        "class",
        "construct",
        "source_pointer",
        "source_inventory_row",
        "message",
        "count",
        "first_path"
      ],
      "additionalProperties": false,
      "properties": {
        "record_id": { "type": "string", "pattern": "^r[0-9]{6}$" },
        "ir_pointer": { "type": "string", "minLength": 1 },
        "tei_pointer": { "type": ["string", "null"] },
        "class": { "enum": ["custom_sidecar", "tei_profile_projection"] },
        "construct": {
          "enum": [
            "accent",
            "diagnostic",
            "figure_metadata",
            "gaiji_resolution",
            "heading_jisage_structure",
            "mapping_identity",
            "paragraph.node_range",
            "paragraph.source_pointer",
            "producer_metrics",
            "source_identity",
            "source_note.classification",
            "span_coordinates",
            "style_rendition"
          ]
        },
        "source_pointer": { "type": ["string", "null"] },
        "source_inventory_row": { "type": ["string", "null"] },
        "message": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 },
        "first_path": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/jsonScalar" }
      }
    }
  }
}
