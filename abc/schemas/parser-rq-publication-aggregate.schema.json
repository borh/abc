{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://w3id.org/abc/schemas/parser-rq-publication-aggregate.schema.json","title":"Parser RQ publication aggregate","version":"1.0.0","type":"object","additionalProperties":false,"required":["schema_id","schema_version","status","qualification_identity_ref","policy_hash","preservation_schema_hash","validator_semantics_hash","census_hash","counts"],"properties":{"schema_id":{"const":"https://w3id.org/abc/schemas/parser-rq-publication-aggregate.schema.json"},"schema_version":{"const":"1.0.0"},"status":{"enum":["ok","unavailable"]},"qualification_identity_ref":{"$ref":"#/$defs/hash"},"policy_hash":{"$ref":"#/$defs/hash"},"preservation_schema_hash":{"$ref":"#/$defs/hash"},"validator_semantics_hash":{"$ref":"#/$defs/hash"},"census_hash":{"$ref":"#/$defs/hash"},"counts":{"type":"object"},"ratio":{"type":"object"},"denominator_shrink_witnesses":{"type":"array"},"failed_work_witnesses":{"type":"array"}},"$defs":{"hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}
