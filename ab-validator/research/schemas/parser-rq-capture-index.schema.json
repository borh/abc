{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/soranoha/schemas/parser-rq-capture-index.schema.json",
  "title": "Parser RQ capture generation index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "capture_generation_ref", "capture_started_at_utc", "authorization_ref", "candidate_ref", "qualification_identity_ref", "members"],
  "properties": {
    "schema_id": {"const": "https://w3id.org/soranoha/schemas/parser-rq-capture-index.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "capture_generation_ref": {"$ref": "#/$defs/hash"},
    "capture_started_at_utc": {"type": "string", "format": "date-time"},
    "authorization_ref": {"$ref": "#/$defs/hash"},
    "candidate_ref": {"$ref": "#/$defs/hash"},
    "qualification_identity_ref": {"$ref": "#/$defs/hash"},
    "members": {
      "type": "object", "additionalProperties": false,
      "required": ["core_attempt", "source_recognition", "diagnostic_gap", "diagnostic_completeness", "parser_ir_conformance", "publication_structure", "resource", "measurements"],
      "properties": {
        "core_attempt": {"$ref": "#/$defs/blob"},
        "source_recognition": {"$ref": "#/$defs/blob"},
        "diagnostic_gap": {"$ref": "#/$defs/blob"},
        "diagnostic_completeness": {"$ref": "#/$defs/blob"},
        "parser_ir_conformance": {"$ref": "#/$defs/blob"},
        "publication_structure": {"$ref": "#/$defs/blob"},
        "resource": {"$ref": "#/$defs/blob"},
        "measurements": {"$ref": "#/$defs/blob"}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "blob": {"type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "media_type", "locator"], "properties": {"sha256": {"$ref": "#/$defs/hash"}, "bytes": {"type": "integer", "minimum": 0}, "media_type": {"type": "string", "minLength": 1}, "locator": {"$ref": "#/$defs/locator"}}},
    "locator": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
  }
}
